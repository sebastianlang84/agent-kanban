def connect_readonly():
    """Open the board read-only, without creating, migrating or writing anything."""
    path = os.path.abspath(os.path.expanduser(os.environ.get('KB_DB') or DEFAULT_DB))
    if not os.path.isfile(path):
        raise UsageError('no board database at %s' % path)
    try:
        conn = sqlite3.connect('file:%s?mode=ro' % urllib.parse.quote(path), uri=True,
                               isolation_level=None)
        conn.execute('PRAGMA busy_timeout=10000')
        version = conn.execute('PRAGMA user_version').fetchone()[0]
    except sqlite3.DatabaseError as e:
        raise UsageError('cannot read board %s: %s' % (path, e))
    if version != SCHEMA_VERSION:
        raise UsageError('database schema version %d, kb report reads %d; any other kb command'
                         ' migrates it' % (version, SCHEMA_VERSION))
    conn.create_function('slabel', 3, session_label)
    return conn


def report_window(args):
    """[start, end) of the report as ISO strings, and its length in days."""
    if args.days is not None and args.days < 1:
        raise UsageError('--days must be at least 1')
    t_now = datetime.datetime.now(datetime.timezone.utc).replace(microsecond=0)
    days = args.days or REPORT_DAYS
    if args.since:
        try:
            start = datetime.datetime.strptime(args.since, '%Y-%m-%d').replace(
                tzinfo=datetime.timezone.utc)
        except ValueError:
            raise UsageError('--since needs YYYY-MM-DD, got %r' % args.since)
        end = start + datetime.timedelta(days=days) if args.days else t_now
        end = min(end, t_now)
        if start >= end:
            raise UsageError('--since %s is not in the past' % args.since)
    else:
        end = t_now
        start = end - datetime.timedelta(days=days)
    return fmt_time(start), fmt_time(end), (end - start).total_seconds() / 86400


def fmt_dur(secs):
    secs = int(secs)
    if secs < 3600:
        return '%dm' % (secs // 60)
    if secs < 86400:
        return '%dh%02dm' % (secs // 3600, secs % 3600 // 60)
    return '%dd%02dh' % (secs // 86400, secs % 86400 // 3600)


def clip(text, width):
    return text if len(text) <= width else text[:max(width - 3, 0)] + '...'


def pct(n, base):
    return '%d%%' % round(100.0 * n / base) if base else '-'


def doing_period(ticket, notes):
    """(start, end) envelope of the time a ticket was held; end None while it is still held.

    A task is held from its creation, a request from its first kb claim; a held period ends
    at the last close, force-close or release note. Release-and-reclaim gaps are not split.
    """
    if ticket['type'] == 'task':
        start = ticket['created']
    else:
        claims = [n['time'] for n in notes if n['kind'] == 'comment' and n['text'] == 'claimed']
        if not claims:
            return None
        start = min(claims)
    if ticket['status'] in OWNED:
        return start, None
    ends = [n['time'] for n in notes if n['kind'] in CLOSING + ('release',)]
    return start, max(ends) if ends else ticket['updated']


def cmd_report(args):
    ws, we, days = report_window(args)
    conn = connect_readonly()
    conn.row_factory = sqlite3.Row
    inw = lambda t: t is not None and ws <= t < we  # noqa: E731
    conn.execute('BEGIN')  # one read snapshot: a concurrent add and close cannot split it
    sessions = conn.execute('SELECT token, name, harness, harness_session, started,'
                            ' installation, slabel(name, harness, token) AS label FROM session'
                            ).fetchall()
    tickets = {r['id']: r for r in conn.execute('SELECT * FROM ticket ORDER BY id')}
    notes = conn.execute('SELECT * FROM note ORDER BY id').fetchall()
    # A harness session is (installation, harness, harness_session): ids collide across machines.
    events = conn.execute('SELECT installation, harness, harness_session, event, time'
                          ' FROM session_event WHERE time>=? AND time<? ORDER BY time, id',
                          (ws, we)).fetchall()
    ever_started = {tuple(r) for r in conn.execute(
        "SELECT DISTINCT installation, harness, harness_session FROM session_event"
        " WHERE event='start'")}
    # Bus history imported on 2026-09-24 (table bus_import) is not board use: its tickets' creation,
    # its notes and its harness-bus sessions are left out. Later live work on them counts.
    bus_tickets, bus_notes = set(), set()
    if conn.execute("SELECT 1 FROM sqlite_master WHERE type='table' AND name='bus_import'"
                    ).fetchone():
        for r in conn.execute('SELECT ticket_id, note_id FROM bus_import'):
            bus_tickets.add(r[0])
            bus_notes.add(r[1])
    conn.execute('COMMIT')
    conn.close()
    bus_sessions = [s for s in sessions if s['harness'] == BUS_HARNESS]
    sessions = [s for s in sessions if s['harness'] != BUS_HARNESS]
    notes = [n for n in notes if n['id'] not in bus_notes]
    by_hid = {(s['installation'], s['harness'], s['harness_session']): s for s in sessions
              if s['harness_session']}
    notes_of = {}
    for n in notes:
        notes_of.setdefault(n['ticket_id'], []).append(n)
    wnotes = [n for n in notes if inw(n['time'])]

    # Board use: a ticket or note write (a kb claim writes a note); a session-ended note is
    # written by the end hook, not by the session's own work. kb board and kb touch leave none.
    first_use = {}
    for t in tickets.values():
        if inw(t['created']) and t['id'] not in bus_tickets:
            first_use[t['opener']] = min(first_use.get(t['opener'], we), t['created'])
    for n in wnotes:
        if n['kind'] != 'session-ended':
            first_use[n['author']] = min(first_use.get(n['author'], we), n['time'])

    def held(token, ticket_id):
        """The session held the ticket, or opened the request it closes (bus semantics)."""
        t = tickets.get(ticket_id)
        if t is None:  # guard: a note whose ticket is not in the snapshot
            return False
        return (t['assignee'] == token or t['opener'] == token
                or any(n['author'] == token and n['kind'] == 'comment' and n['text'] == 'claimed'
                       for n in notes_of.get(ticket_id, ())))

    closers = {n['author'] for n in wnotes if n['kind'] == 'close' and held(n['author'],
                                                                            n['ticket_id'])}

    # Denominator: harness sessions with a start event in the window.
    evs = {}
    for e in events:
        evs.setdefault((e['installation'], e['harness'], e['harness_session']), []).append(e)
    started = sorted(k for k, v in evs.items() if any(e['event'] == 'start' for e in v))
    harnesses = sorted({h for _, h, _ in started}, key=lambda h: (h not in HARNESSES,
                                                               HARNESSES.index(h)
                                                               if h in HARNESSES else 0, h))
    rows = {k: {h: 0 for h in harnesses} for k in
            ('started', 'short', 'base', 'used', 'closed', 'left', 'other', 'none')}
    for hid in started:
        h, v = hid[1], evs[hid]
        s = by_hid.get(hid)
        token = s['token'] if s else None
        first_start = min(e['time'] for e in v if e['event'] == 'start')
        ends = [e['time'] for e in v if e['event'] == 'end']
        ended = v[-1]['event'] == 'end'  # a start or stop after the last end: resumed
        # Lifetime only for an ended session whose last end follows every start in the window.
        lifetime = None
        if ended and all(e['time'] <= max(ends) for e in v if e['event'] == 'start'):
            lifetime = (parse_time(max(ends)) - parse_time(first_start)).total_seconds()
        # Left open: the end hook noted a ticket this session still held at its last end.
        left = ended and any(n['author'] == token and n['kind'] == 'session-ended'
                             and n['time'] >= ends[-1] for n in wnotes)
        used = left or token in first_use
        rows['started'][h] += 1
        if not used and lifetime is not None and lifetime < SHORT_RUN_SECS:
            rows['short'][h] += 1
            continue
        rows['base'][h] += 1
        if not used:
            rows['none'][h] += 1
            continue
        rows['used'][h] += 1
        rows['left' if left else 'closed' if token in closers else 'other'][h] += 1

    out = []
    p = out.append
    p('kb report  %s .. %s  (UTC, %g days)' % (ws, we, round(days, 2)))
    p('Imported bus history excluded (counted): %d tickets, %d notes, %d sessions of harness %s'
      % (len(bus_tickets), len(bus_notes), len(bus_sessions), BUS_HARNESS))
    p('')
    p('Sessions (counted). Denominator: harness sessions with a start event in the window,')
    p('without the short runs; each % is of the denominator in its column.')
    cols = harnesses + ['total']
    p(('  %-24s' % '' + ''.join('%7s     ' % c for c in cols)).rstrip())

    def line(label, key, with_pct=True):
        cells = [rows[key][h] for h in harnesses]
        cells.append(sum(cells))
        bases = [rows['base'][h] for h in harnesses]
        bases.append(sum(bases))
        p(('  %-24s' % label + ''.join('%7d %4s' % (c, pct(c, b) if with_pct else '')
                                       for c, b in zip(cells, bases))).rstrip())

    line('started in window', 'started', False)
    line('short, no use (excluded)', 'short', False)
    line('denominator', 'base', False)
    line('used board', 'used')
    line('  closed', 'closed')
    line('  left open', 'left')
    line('  other use', 'other')
    line('no board use', 'none')
    p('Short, no use (likely child runs): ended, first start to last end under %d minutes, no'
      % (SHORT_RUN_SECS // 60))
    p('board use; reviewer runs (claude -p, codex exec, pi -p) fire the hooks too. They are excluded')
    p('from the denominator. Board use: a ticket or note write in the window (add, claim, note,')
    p('close, ...); kb board and kb touch leave no record and do not count. One class per session:')
    p('left open (held a doing/blocked ticket at its last end), else closed (closed a ticket it')
    p('held, or a request it opened), else other use.')

    # Sessions that used kb without a start event in the window would otherwise be lost.
    started_set = set(started)
    extra = []
    for s in sessions:
        hid = (s['installation'], s['harness'], s['harness_session'])
        if hid in started_set:
            continue
        uses = [t for t in (first_use.get(s['token']), s['started'] if inw(s['started'])
                            else None) if t]
        if not uses:
            continue
        if not s['harness_session']:
            why = 'kb start, no harness id'
        elif hid in ever_started:
            why = 'started before the window'
        else:
            why = 'auto-registered, no start'
        extra.append((min(uses), s['label'], why))
    p('')
    p('Sessions that used kb without a start event in the window (counted: %d; not in the'
      ' denominator)' % len(extra))
    for first, label, why in sorted(extra):
        p('  %-34s first use %s  %s' % (clip(label, 34), first, why))

    # Tickets.
    added = [t for t in tickets.values() if inw(t['created']) and t['id'] not in bus_tickets]
    claimed_ids = {n['ticket_id'] for n in wnotes if n['kind'] == 'comment'
                   and n['text'] == 'claimed'}
    task_adds = {t['id'] for t in added if t['type'] == 'task'}
    closed_ids = {n['ticket_id'] for n in wnotes if n['kind'] in CLOSING
                  and n['ticket_id'] in tickets}
    abandoned = [t for t in tickets.values() if t['status'] == 'abandoned' and inw(t['updated'])]
    periods = {i: doing_period(t, notes_of.get(i, [])) for i, t in tickets.items()}
    periods = {i: pr for i, pr in periods.items() if pr}
    at_end = [i for i, (a, b) in periods.items() if a < we and (b is None or b >= we)]
    durations = []
    for i in sorted(closed_ids):
        t = tickets[i]
        last_close = max(n['time'] for n in notes_of[i] if n['kind'] in CLOSING)
        if t['claimed_at'] and t['status'] == 'done':
            durations.append((parse_time(last_close) - parse_time(t['claimed_at'])
                              ).total_seconds())
    p('')
    p('Tickets (counted, events in the window)')
    p('  added        %4d  (task %d, request %d)' % (
        len(added), len(task_adds), len(added) - len(task_adds)))
    p('  claimed      %4d  (kb claim %d, kb add of a task %d)' % (
        len(claimed_ids | task_adds), len(claimed_ids), len(task_adds - claimed_ids)))
    p('  closed       %4d  (close or force-close note)' % len(closed_ids))
    p('  abandoned    %4d  (status abandoned, last updated in the window)' % len(abandoned))
    p('  still doing  %4d  (doing or blocked at the window end)' % len(at_end))
    if durations:
        p('  claim to close (measured, %d done tickets, claimed_at to last close): median %s,'
          ' max %s' % (len(durations), fmt_dur(statistics.median(durations)),
                       fmt_dur(max(durations))))
    else:
        p('  claim to close: no done ticket closed in the window')
    ended = []
    for i, t in tickets.items():
        se = [n['time'] for n in notes_of.get(i, ()) if n['kind'] == 'session-ended'
              and inw(n['time'])]
        if se and not any(n['kind'] in CLOSING and n['time'] >= max(se) for n in notes_of[i]):
            ended.append(t)
    p('  session-ended note and no later close: %d' % len(ended))
    for t in ended:
        p('    #%-4d %-9s %s' % (t['id'], t['status'], clip(t['title'], WIDTH - 20)))

    # Duplicate candidates, with the similarity rule of kb add.
    pairs = []
    ids = sorted(periods)
    for x, a in enumerate(ids):
        for b in ids[x + 1:]:
            ta, tb = tickets[a], tickets[b]
            if ta['repo'] != tb['repo']:
                continue
            lo = max(periods[a][0], periods[b][0], ws)
            hi = min(periods[a][1] or we, periods[b][1] or we, we)
            if lo >= hi:  # half-open periods: touching ones do not overlap
                continue
            ratio = difflib.SequenceMatcher(None, ta['title'].lower(),
                                            tb['title'].lower()).ratio()
            if ratio >= SIMILARITY:
                pairs.append((ta, tb, ratio))
    p('')
    p('Duplicate candidates (counted: %d; same repo, overlapping doing periods in the window,'
      % len(pairs))
    p('title ratio >= %g as in kb add)' % SIMILARITY)
    for ta, tb, ratio in pairs:
        p('  #%d ~ #%d  ratio %.2f  repo %s' % (ta['id'], tb['id'], ratio,
                                               ta['repo'] or 'cross-repo'))
        for t in (ta, tb):
            p('    #%-4d %s' % (t['id'], clip(t['title'], WIDTH - 10)))
    p('')
    p('Known limits: a release and a later reclaim count as one held period; "abandoned" and claim')
    p('to close use the current ticket state, so a later reopen changes past reports.')
    print('\n'.join(clip(l, WIDTH) for l in out))


# --- guest mode (D9): forwarding over ssh and kb serve on the host -------------

REQUEST_VERSION = 1
REQUEST_MAX = 64 * 1024  # bytes of the request line, newline included
BODY_MAX = 1024 * 1024  # bytes of the command's stdin after the request line
SERVE_DEADLINE = 30.0  # seconds for kb serve to receive the request line and the body
IDENTITY_ENV = tuple(v for _, v in HARNESS_ENV) + ('KB_SESSION',)
CTX_FIELDS = ('host', 'cwd', 'name', 'toplevel', 'repo', 'branch')
# Every command a guest may run; curator-only and host-only ones are missing on purpose.
GUEST_COMMANDS = ('start', 'add', 'claim', 'block', 'resume', 'release', 'close', 'abandon',
                  'reopen', 'note', 'touch', 'session-ended', 'board', 'show', 'report',
                  'sessions', 'whoami')
HOST_ONLY = ('restore', 'recover', 'serve', 'authorize')
STDIN_COMMANDS = ('note', 'close')  # read note text always; the others only with --stdin


def guest_context():
    """What depends on the guest machine, resolved there; the installation is not part of it."""
    cwd = os.getcwd()
    name, top = derive_name(cwd)
    branch = (git(top, 'rev-parse', '--abbrev-ref', 'HEAD') or '') if top else ''
    return {'host': socket.gethostname(), 'cwd': cwd, 'name': name, 'toplevel': top,
            'repo': repo_name(top) if top else '', 'branch': branch,
            'env': {v: os.environ[v] for v in IDENTITY_ENV if os.environ.get(v, '').strip()}}


def guest_main(argv, host):
    """Run one command on the board host through the guest's forced-command ssh key."""
    args = build_parser().parse_args(argv)  # usage errors and help stay local
    if args.command in HOST_ONLY:
        sys.stderr.write('kb: %s runs on the host only\n' % args.command)
        return EXIT_REJECTED
    try:
        key = guest_key(host)
    except UsageError as e:
        sys.stderr.write('kb: %s\n' % e)
        return EXIT_USAGE
    request = request_line(argv, guest_context())
    # Only commands that read note text get the guest's stdin; any other would wait for EOF.
    if (args.command in STDIN_COMMANDS or getattr(args, 'stdin', False)) \
            and sys.stdin is not None and not sys.stdin.isatty():
        request += sys.stdin.buffer.read()
    sys.stdout.flush()
    try:
        p = subprocess.Popen(ssh_command(host, key, 5), stdin=subprocess.PIPE,
                             stderr=subprocess.PIPE)
    except OSError as e:
        sys.stderr.write('kb: board host %s unreachable: %s\n' % (host, e))
        return EXIT_USAGE
    _, err = p.communicate(request)
    if p.returncode == SSH_FAILED:
        sys.stderr.write(unreachable(host, err))
        return EXIT_USAGE
    sys.stderr.flush()
    sys.stderr.buffer.write(err)
    sys.stderr.buffer.flush()
    return p.returncode


def unreachable(host, err):
    """The one stderr line for an ssh exit 255, with ssh's last stderr line."""
    lines = err.decode('utf-8', 'replace').strip().splitlines()
    return 'kb: board host %s unreachable: %s\n' % (host,
                                                    lines[-1] if lines else 'ssh exit 255')


def guest_key(host):
    """The guest's ssh key path; UsageError when guest mode is not set up."""
    key = setting('KB_SSH_KEY')
    if not INSTALLATION_RE.fullmatch(setting('KB_INSTALLATION')) or not key \
            or not os.path.isfile(os.path.expanduser(key)):
        raise UsageError('guest mode needs KB_INSTALLATION and KB_SSH_KEY; run kb setup')
    if host.startswith('-'):
        raise UsageError('invalid KB_HOST %r' % host)
    return os.path.expanduser(key)


def ssh_command(host, key, connect_timeout):
    # The command word is ignored: the host's forced command runs kb serve. No argument
    # travels in the ssh command line, so no remote shell quotes anything.
    return ['ssh', '-o', 'BatchMode=yes', '-o', 'IdentitiesOnly=yes', '-i', key,
            '-o', 'ConnectTimeout=%d' % connect_timeout, host, 'kb']


def request_line(argv, ctx):
    return json.dumps({'v': REQUEST_VERSION, 'argv': argv, 'ctx': ctx},
                      ensure_ascii=True).encode() + b'\n'


def read_request(stream):
    """The request line of kb serve: {"v": 1, "argv": [...], "ctx": {...}}."""
    line = stream.readline(REQUEST_MAX + 1)
    if len(line) > REQUEST_MAX or not line.endswith(b'\n'):
        raise Rejected('serve rejected: request line missing or over %d bytes' % REQUEST_MAX)
    try:
        req = json.loads(line.decode('utf-8'))
    except Exception:  # noqa: B902 - ValueError, RecursionError from deep nesting, ...
        raise Rejected('serve rejected: request line is not JSON')
    if not isinstance(req, dict) or req.get('v') != REQUEST_VERSION:
        raise Rejected('serve rejected: request version is not %d' % REQUEST_VERSION)
    argv, ctx = req.get('argv'), req.get('ctx')
    if not (isinstance(argv, list) and argv and all(isinstance(a, str) for a in argv)
            and isinstance(ctx, dict) and all(isinstance(ctx.get(f), str) for f in CTX_FIELDS)
            and isinstance(ctx.get('env'), dict)
            and all(k in IDENTITY_ENV and isinstance(v, str) for k, v in ctx['env'].items())):
        raise Rejected('serve rejected: malformed request')
    return argv, ctx


def cmd_serve(args):
    """Host side of guest mode, run only as the ssh forced command of one guest's key."""
    global GUEST
    if sys.stdin is None or sys.stdin.isatty() or not os.environ.get('SSH_CONNECTION'):
        raise Rejected('serve rejected: runs only as an ssh forced command')
    if not INSTALLATION_RE.fullmatch(args.installation):
        raise Rejected('serve rejected: --installation must be 16 lowercase hex digits')
    if args.installation == host_installation(connect()):
        raise Rejected("serve rejected: --installation is this host's own")
    # One deadline for the whole request, so a stalled guest cannot hold a host process.
    try:
        deadline = float(os.environ.get('KB_SERVE_DEADLINE') or SERVE_DEADLINE)
    except ValueError:
        deadline = SERVE_DEADLINE

    def expired(signum, frame):
        raise Rejected('serve rejected: request not received within %g s' % deadline)
    signal.signal(signal.SIGALRM, expired)
    signal.setitimer(signal.ITIMER_REAL, deadline)
    argv, ctx = read_request(sys.stdin.buffer)
    hook = argv[0] == 'hook' and (argv == ['hook', 'ingest'] or argv[1:2] in (['prompt'],
                                                                             ['guard']))
    if not hook and argv[0] not in GUEST_COMMANDS:
        raise Rejected('serve rejected: %r is not allowed from a guest'
                       % (' '.join(argv[:2]) if argv[0] == 'hook' else argv[0])[:40])
    sub = None if hook else build_parser().parse_args(argv)
    if sub is not None and (sub.command not in GUEST_COMMANDS or (
            sub.command == 'start' and sub.name.strip() == CURATOR)):
        raise Rejected('serve rejected: %s is not allowed from a guest' % sub.command)
    # The installation comes from the forced command, never from the request.
    GUEST = {f: ctx[f] for f in CTX_FIELDS}
    GUEST.update(env=dict(ctx['env']), inst=args.installation)
    # The rest of the ssh stdin, unchanged, is the command's stdin; bounded before any
    # command reads it. The guest closes stdin after the body, so this never waits.
    body = sys.stdin.buffer.read(BODY_MAX + 1)
    signal.setitimer(signal.ITIMER_REAL, 0)
    if len(body) > BODY_MAX:
        raise Rejected('serve rejected: stdin over %d bytes' % BODY_MAX)
    sys.stdin = io.TextIOWrapper(io.BytesIO(body), encoding='utf-8', errors='replace',
                                 newline='')
    if argv == ['hook', 'ingest']:
        return hook_ingest(body, args.installation)
    if hook:  # prompt, guard: hook_main logs to the host's hook-errors.log and exits 0
        return hook_main(argv[1:])
    return run(sub)


# --- hooks on a guest (D9 step 5): deadline, spool and kb hook ingest -----------

HOOK_DEADLINE = 1.0  # seconds from hook start; Claude Code's SessionEnd budget is 1.5 s
HOOK_DEADLINE_MAX = 1.3  # KB_HOOK_DEADLINE above this, or not above 0, falls back to the default
EVENT_MAX = 8 * 1024  # bytes of one spooled event; 20 of them stay far below BODY_MAX
INGEST_MAX = 50  # events per kb hook ingest request; the rest stays in the guest's spool
INGEST_DEADLINE = 10.0  # seconds kb hook ingest processes events after the body arrived
SPOOL_SCAN = 0.2  # seconds for listing and reading the spool within the deadline
GIT_LOOKUP = 0.3  # seconds for the git lookup of name, toplevel and repo
SPOOL_BATCH = 20  # oldest spooled events sent per request
EVENT_ID_RE = re.compile(r'[0-9a-f]{16}-[0-9a-f]{16}')
TIME_RE = re.compile(r'[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z')  # as now() writes
EVENT_FIELDS = ('harness', 'hsid', 'event', 'source', 'cwd', 'host', 'name', 'toplevel',
                'repo', 'time')


def spool_dir():
    return os.path.join(data_dir(), 'spool')


def spool_names():
    """Spooled event files, oldest first: names sort by occurrence time, then event id."""
    try:
        names = os.listdir(spool_dir())
    except FileNotFoundError:
        return []
    return sorted(n for n in names if n.endswith('.json'))


def spool_write(ev):
    """One file per event, renamed into place: concurrent writers need no lock."""
    test_barrier()
    d = spool_dir()
    os.makedirs(d, mode=0o700, exist_ok=True)
    name = '%020d-%s.json' % (ev['ns'], ev['id'])
    tmp = os.path.join(d, name + '.tmp')
    with open(tmp, 'w', encoding='utf-8') as f:
        json.dump(ev, f)
    os.replace(tmp, os.path.join(d, name))
    return name


def spool_read(names, limit, until=None):
    """[(name, event)] of the first readable files, at most limit, until a monotonic time.

    A file a concurrent drain removed is skipped; an unreadable, invalid or oversized one
    is set aside as .bad, so it never blocks the events behind it.
    """
    out = []
    for name in names:
        if len(out) >= limit or (until is not None and time.monotonic() > until):
            break
        path = os.path.join(spool_dir(), name)
        try:
            with open(path, 'rb') as f:
                data = f.read(EVENT_MAX + 1)
            if len(data) > EVENT_MAX:
                raise ValueError('spooled event over %d bytes' % EVENT_MAX)
            ev = json.loads(data.decode('utf-8'))
            if not (isinstance(ev, dict) and isinstance(ev.get('id'), str)
                    and EVENT_ID_RE.fullmatch(ev['id'])):
                raise ValueError('spooled event without a valid id')
        except FileNotFoundError:
            continue
        except (OSError, ValueError) as e:
            log_hook_error(['spool', name], e)
            with contextlib.suppress(OSError):
                os.replace(path, path + '.bad')
            continue
        out.append((name, ev))
    return out


def spool_remove(name):
    with contextlib.suppress(FileNotFoundError):
        os.remove(os.path.join(spool_dir(), name))


def hook_ctx(ev=None):
    """Request context of a hook request; the host takes each event's own fields."""
    ev = ev or {}
    return {'host': socket.gethostname(), 'cwd': ev.get('cwd') or os.getcwd(),
            'name': ev.get('name', ''), 'toplevel': ev.get('toplevel', ''),
            'repo': ev.get('repo', ''), 'branch': '', 'env': {}}


def batch_body(batch):
    """JSON lines; live only for an event sent by the hook call it happened in."""
    return b''.join(json.dumps(dict({k: v for k, v in ev.items() if k != 'ns'},
                                    live=ev.get('live', False)), ensure_ascii=True).encode()
                    + b'\n' for _, ev in batch)


def send_request(host, key, argv, body, ctx, timeout, connect_timeout):
    """(exit code, stdout, stderr) of one request; exit code None when timeout expired.

    On expiry ssh and its process group are killed; stdout holds what arrived until then.
    """
    posix = os.name == 'posix'
    p = subprocess.Popen(ssh_command(host, key, connect_timeout), stdin=subprocess.PIPE,
                         stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                         start_new_session=posix)
    try:
        out, err = p.communicate(request_line(argv, ctx) + body, timeout=timeout)
        return p.returncode, out, err
    except subprocess.TimeoutExpired as e:
        out, err = e.output or b'', e.stderr or b''
        with contextlib.suppress(OSError):
            if posix:
                os.killpg(p.pid, signal.SIGKILL)
            else:
                p.kill()
        with contextlib.suppress(subprocess.TimeoutExpired, OSError, ValueError):
            out, err = p.communicate(timeout=0.05)
        return None, out, err


def acknowledged(out, batch):
    """Event ids of the batch on complete lines of the host's stdout."""
    ids = {ev['id'] for _, ev in batch}
    return {l for l in out.decode('ascii', 'replace').split('\n')[:-1] if l in ids}


def failure(host, code, err):
    lines = err.decode('utf-8', 'replace').strip().splitlines()
    what = 'no answer within the deadline' if code is None else 'exit %d' % code
    return '%s: %s%s' % (host, what, ': ' + lines[-1] if lines else '')


def read_hook_input(args, until):
    """hook_input within the deadline: a daemon thread reads fd 0, abandoned on expiry."""
    if args.harness == 'pi' or sys.stdin is None or sys.stdin.isatty():
        return ''
    box = []

    def reader():
        chunks = []
        with contextlib.suppress(OSError):
            while True:
                b = os.read(0, 65536)  # raw fd: no buffer lock held at interpreter exit
                if not b:
                    break
                chunks.append(b)
            box.append(b''.join(chunks).decode('utf-8', 'replace'))
    t = threading.Thread(target=reader, daemon=True)
    t.start()
    t.join(max(0.0, until - time.monotonic()))
    if not box:
        raise UsageError('hook input not received within the deadline')
    return box[0]


def guest_names(cwd, timeout):
    """name, toplevel and repo for a guest event: one git call, else the cwd basename."""
    top = repo = ''
    if timeout > 0:
        try:
            r = subprocess.run(['git', '-C', cwd, 'rev-parse', '--show-toplevel',
                                '--path-format=absolute', '--git-common-dir'],
                               stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                               universal_newlines=True, timeout=timeout)
            lines = r.stdout.splitlines() if r.returncode == 0 else []
        except (OSError, subprocess.SubprocessError, ValueError):
            lines = []
        if len(lines) == 2:
            top, repo = lines[0], repo_from_common(lines[1])
    base = repo or os.path.basename(os.path.abspath(cwd).rstrip('/\\'))
    return {'name': safe_name(base), 'toplevel': top, 'repo': repo}


def occurrence(ns):
    return datetime.datetime.fromtimestamp(ns // 10**9, datetime.timezone.utc).strftime(
        '%Y-%m-%dT%H:%M:%SZ')


def guest_hook(argv, host):
    """kb hook on a guest: always exit 0; errors go to the guest's hook-errors.log.

    One deadline (KB_HOOK_DEADLINE, default 1 s from here) covers the payload read, git
    lookup, spool scan, ssh start, connect and the host's run. The guest never opens a database.
    """
    t0 = time.monotonic()
    try:
        if os.environ.get('PI_SUBAGENT_DEPTH', '0').strip() not in ('', '0'):
            return EXIT_OK
        raw_limit = os.environ.get('KB_HOOK_DEADLINE') or ''
        try:
            limit = float(raw_limit or HOOK_DEADLINE)
        except ValueError:
            limit = None
        if limit is None or not 0 < limit <= HOOK_DEADLINE_MAX:
            log_hook_error(argv, UsageError('KB_HOOK_DEADLINE %r is not in (0, %g] s; using %g s'
                                            % (raw_limit, HOOK_DEADLINE_MAX, HOOK_DEADLINE)))
            limit = HOOK_DEADLINE
        until = t0 + limit
        args = hook_parser().parse_args(argv)
        key = guest_key(host)
        ev = hook_event(args, read_hook_input(args, until))
        if ev['event'] == 'guard' and not ev['source']:
            pass  # the prefilter: no ssh for a shell call that is not guarded
        elif ev['event'] in ('prompt', 'guard'):
            guest_prompt(host, key, ev, until)
        else:
            guest_event(host, key, ev, until)
    except SystemExit:  # --help
        pass
    except BaseException as e:  # noqa: B036 - a hook must never fail its harness
        log_hook_error(argv, e)
    return EXIT_OK


def guest_event(host, key, ev, until):
    """Deliver a start, stop or end behind the oldest spooled events.

    The event is on disk before any network I/O and leaves the spool only when the host
    acknowledges it, so after the deadline nothing is left to write.
    """
    ns = time.time_ns()
    inst = setting('KB_INSTALLATION')
    ev.update(id='%s-%s' % (inst, secrets.token_hex(8)), inst=inst,
              host=socket.gethostname(), time=occurrence(ns), ns=ns)
    ev.update(guest_names(ev['cwd'], min(GIT_LOOKUP, until - time.monotonic() - 0.05)))
    if len(json.dumps(ev, ensure_ascii=True)) > EVENT_MAX:
        raise UsageError('hook event over %d bytes, dropped' % EVENT_MAX)
    others = spool_names()
    name = spool_write(ev)
    if others:  # nothing overtakes an earlier event: ev queues behind the spool
        batch = spool_read(sorted(others + [name]), SPOOL_BATCH,
                           min(time.monotonic() + SPOOL_SCAN, until))
    else:
        batch = [(name, dict(ev, live=True))]  # delivered when it happened
    left = until - time.monotonic()
    if not batch or left <= 0:
        raise UsageError('hook deadline spent before sending; event spooled')
    code, out, err = send_request(host, key, ['hook', 'ingest'], batch_body(batch),
                                  hook_ctx(ev), left, 1)
    acked = acknowledged(out, batch)
    for n, e in batch:
        if e['id'] in acked:
            spool_remove(n)
    if code != 0:
        raise UsageError('board host %s' % failure(host, code, err))


def guest_prompt(host, key, ev, until):
    """Prompt hints or a guard warning from the host, live only: nothing printed or spooled
    on any failure.

    Accepted loss (curator decision, D9 step 5): when the host commits the hints as seen but
    the deadline kills ssh before its stdout arrives, those hints are not shown again; they
    stay listed on `kb board --to <name>`. The rejected alternative is two-phase: the host
    marks hints offered and the guest's next hook call confirms them.
    """
    left = until - time.monotonic()
    if left <= 0:
        raise UsageError('hook deadline spent before sending')
    argv = ['hook', ev['event'], '--harness', ev['harness'], '--id=' + ev['hsid'],
            '--cwd=' + ev['cwd']] + (['--source=' + ev['source']] if ev['event'] == 'guard'
                                     else [])
    code, out, err = send_request(host, key, argv, b'', hook_ctx(ev), left, 1)
    if code != 0:
        raise UsageError('board host %s' % failure(host, code, err))
    sys.stdout.buffer.write(out)
    sys.stdout.flush()


def ingest_event(line, inst):
    """(event id to acknowledge or None, event for apply_event or None, error or None)."""
    try:
        d = json.loads(line)
    except Exception:  # noqa: B902 - ValueError, RecursionError from deep nesting, ...
        return None, None, 'not JSON'
    eid = d.get('id') if isinstance(d, dict) else None
    if not isinstance(eid, str) or not EVENT_ID_RE.fullmatch(eid):
        return None, None, 'no valid event id'
    if d.get('inst') != inst or not eid.startswith(inst + '-'):
        return eid, None, 'event %s is not of installation %s' % (eid, inst)
    if not (all(isinstance(d.get(k), str) for k in EVENT_FIELDS)
            and isinstance(d.get('live'), bool) and d['harness'] in HARNESSES
            and d['event'] in ('start', 'stop', 'end') and d['hsid'].strip()):
        return eid, None, 'event %s is malformed' % eid
    # Canonical form only: times are compared as strings (min, report windows, board join).
    if not TIME_RE.fullmatch(d['time']):
        return eid, None, 'event %s has an invalid time' % eid
    try:
        parse_time(d['time'])
    except ValueError:
        return eid, None, 'event %s has an invalid time' % eid
    received = now()
    return eid, {'inst': inst, 'harness': d['harness'], 'hsid': d['hsid'].strip(),
                 'event': d['event'], 'source': d['source'], 'cwd': d['cwd'],
                 'host': d['host'], 'name': safe_name(d['name']), 'toplevel': d['toplevel'],
                 'time': min(d['time'], received), 'received': received, 'event_id': eid,
                 'live': d['live']}, None


def hook_ingest(body, inst):
    """kb hook ingest, reached through kb serve: one JSON line per guest hook event.

    Each event gets its own transaction; its id is printed after COMMIT, and also for a
    duplicate or an invalid event (logged here), so no event blocks the guest's spool.
    Events past INGEST_MAX or INGEST_DEADLINE are not acknowledged; they stay spooled.
    """
    try:
        limit = float(os.environ.get('KB_INGEST_DEADLINE') or INGEST_DEADLINE)
    except ValueError:
        limit = INGEST_DEADLINE
    until = time.monotonic() + limit
    conn = connect(HOOK_BUSY_MS)
    lines = [l for l in body.decode('utf-8', 'replace').splitlines() if l.strip()]
    for line in lines[:INGEST_MAX]:
        if time.monotonic() > until:
            break
        eid, ev, err = ingest_event(line, inst)
        if err:
            log_hook_error(['ingest', '--installation', inst], Rejected(err))
        else:
            apply_event(conn, ev)
        if eid:
            sys.stdout.write(eid + '\n')
            sys.stdout.flush()
    return EXIT_OK


def cmd_spool(args):
    """kb spool [--drain]: hook events this guest has not delivered yet."""
    if not args.drain:
        print('%d spooled hook event(s)' % len(spool_names()))
        return EXIT_OK
    host = setting('KB_HOST')
    if not host:
        raise UsageError('kb spool --drain runs on a guest (KB_HOST)')
    key = guest_key(host)
    sent = acked = 0
    code = 0
    while True:
        batch = spool_read(spool_names(), SPOOL_BATCH)
        if not batch:
            break
        try:
            code, out, err = send_request(host, key, ['hook', 'ingest'], batch_body(batch),
                                          hook_ctx(), None, 5)
        except OSError as e:  # no ssh program
            code, err = SSH_FAILED, str(e).encode()
            out = b''
        ids = acknowledged(out, batch)  # complete lines count even if ssh then failed
        if ids or code != SSH_FAILED:  # exit 255 without an id: nothing reached the host
            sent += len(batch)
        for name, ev in batch:
            if ev['id'] in ids:
                spool_remove(name)
                acked += 1
        if code == SSH_FAILED:
            sys.stderr.write(unreachable(host, err))
            break
        if not ids:
            sys.stderr.write('kb: board host %s\n' % failure(host, code, err))
            break
    left = len(spool_names())
    print('sent %d, acknowledged %d, %d left in the spool' % (sent, acked, left))
    return EXIT_USAGE if code == SSH_FAILED else EXIT_OK if not left else EXIT_REJECTED


# --- kb authorize: a guest key on the host (curator) --------------------------

KEY_TYPE_RE = re.compile(r'ssh-ed25519|ssh-rsa|ecdsa-sha2-nistp(256|384|521)')
KEY_BLOB_RE = re.compile(r'[A-Za-z0-9+/]+={0,2}')
LABEL_RE = re.compile(r'[A-Za-z0-9._-]{1,40}')
KB_PATH_RE = re.compile(r'[A-Za-z0-9._/+-]+')


def public_key(path):
    """(type, base64) of the one public key in path (- for stdin); anything else is refused."""
    if path == '-':
        raw = sys.stdin.buffer.read(16 * 1024 + 1) if sys.stdin is not None else b''
        path = 'stdin'
    else:
        try:
            with open(path, 'rb') as f:
                raw = f.read(16 * 1024 + 1)
        except OSError as e:
            raise UsageError('cannot read public key %s: %s' % (path, e.strerror))
    try:
        text = raw.decode('ascii')
    except UnicodeDecodeError:
        raise UsageError('public key file is not ASCII: %s' % path)
    if len(raw) > 16 * 1024 or text.count('\n') > 1 or not text.strip():
        raise UsageError('public key file must hold exactly one line: %s' % path)
    line = text[:-1] if text.endswith('\n') else text
    if any(c < ' ' or c == '\x7f' for c in line):
        raise UsageError('public key file has control characters: %s' % path)
    parts = line.split(' ')
    if len(parts) < 2 or not KEY_TYPE_RE.fullmatch(parts[0]) \
            or not KEY_BLOB_RE.fullmatch(parts[1]):
        raise UsageError('not an ssh-ed25519, ssh-rsa or ecdsa-sha2-* public key: %s' % path)
    try:
        with tempfile.TemporaryDirectory(prefix='kb-key-') as tmp:  # the checked line only
            checked = os.path.join(tmp, 'key.pub')
            with open(checked, 'w', encoding='ascii') as f:
                f.write(line + '\n')
            r = subprocess.run(['ssh-keygen', '-l', '-f', checked], stdout=subprocess.PIPE,
                               stderr=subprocess.PIPE, universal_newlines=True, timeout=10)
    except (OSError, subprocess.SubprocessError) as e:
        raise UsageError('cannot run ssh-keygen: %s' % e)
    if r.returncode != 0 or len(r.stdout.strip().splitlines()) != 1:
        raise UsageError('ssh-keygen does not accept %s as one public key' % path)
    return parts[0], parts[1]


def cmd_authorize(args):
    """Append the forced-command line of one guest key to ~/.ssh/authorized_keys."""
    if not INSTALLATION_RE.fullmatch(args.installation):
        raise UsageError('--installation must be 16 lowercase hex digits')
    if not LABEL_RE.fullmatch(args.label):
        raise UsageError('--label must be 1 to 40 of A-Z a-z 0-9 . _ -')
    ktype, blob = public_key(args.pubkey)
    conn = connect()
    _, name = session(conn, args)
    if not is_curator(name):
        raise Rejected('authorize rejected: curator only')
    if args.installation == host_installation(conn):
        raise Rejected("authorize rejected: --installation is this host's own")
    kb_path = os.path.abspath(sys.argv[0])
    if not KB_PATH_RE.fullmatch(kb_path):
        raise UsageError('kb path has characters an authorized_keys command cannot hold: %r'
                         % kb_path)
    entry = 'command="%s serve --installation %s",restrict %s %s kb-guest-%s' % (
        kb_path, args.installation, ktype, blob, args.label)
    ssh_dir = os.path.join(os.path.expanduser('~'), '.ssh')
    path = os.path.join(ssh_dir, 'authorized_keys')
    os.makedirs(ssh_dir, mode=0o700, exist_ok=True)
    import fcntl  # the host is POSIX; a Windows guest never reaches this
    # One writer at a time from read to replace, so concurrent calls cannot lose a key.
    with open(os.path.join(ssh_dir, '.kb-authorize.lock'), 'a') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        added, backup = append_authorized(path, entry, blob, args.installation)
    if not added:
        print('already authorized: kb-guest-%s in %s' % (args.label, path))
        return
    print('authorized kb-guest-%s (installation %s) in %s%s'
          % (args.label, args.installation, path, '; backup %s' % backup if backup else ''))


def append_authorized(path, entry, blob, inst):
    """Under the authorize lock: append entry unless present; (added, backup path or None)."""
    if os.path.islink(path):  # os.replace would turn the link into a regular file
        raise Rejected('authorize rejected: %s is a symlink; edit its target by hand' % path)
    try:
        with open(path, encoding='utf-8') as f:
            text = f.read()
    except FileNotFoundError:
        text = None
    for line in (text or '').splitlines():
        if line.strip() == entry:
            return False, None
        if blob in line.split():
            raise Rejected('authorize rejected: this key already has another line in %s' % path)
        # One installation, one key: another key with this id could present its sessions.
        if re.search(r'serve --installation %s"' % inst, line):
            raise Rejected('authorize rejected: installation %s already belongs to another'
                           ' key in %s' % (inst, path))
    backup = None
    if text is not None:
        backup = '%s.kb-backup-%s-%d' % (path, now().replace(':', ''), os.getpid())
        shutil.copy2(path, backup)
        if text and not text.endswith('\n'):
            text += '\n'
    tmp = '%s.kb-tmp.%d' % (path, os.getpid())
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    with os.fdopen(fd, 'w', encoding='utf-8') as f:
        f.write((text or '') + entry + '\n')
    if text is not None:
        shutil.copymode(path, tmp)
    os.replace(tmp, path)
    return True, backup


