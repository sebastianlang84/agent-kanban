BOARD_LINE = ('- Run `kb board --repo <repo>` before starting a task and load the `using-kb`'
              ' skill.')
PI_KB_PLACEHOLDER = '@KB_COMMAND@'
PI_MARK = '// installed by kb setup'  # first line of hooks/pi/kb.ts; only such a file is replaced
# Harness event names per kb hook event; timeouts in seconds, as the README lists them.
HOOK_NAMES = (('start', 'SessionStart'), ('stop', 'Stop'), ('end', 'SessionEnd'),
              ('prompt', 'UserPromptSubmit'), ('guard', 'PreToolUse'))
HOOK_TIMEOUTS = {'claude': {'start': 10, 'stop': 10, 'end': 5, 'prompt': 5, 'guard': 5},
                 'codex': {'start': 10, 'stop': 10, 'end': 3, 'prompt': 5, 'guard': 5}}
HOOK_MATCHERS = {'guard': 'Bash'}  # tool name: both harnesses call their shell tool Bash


PYTHON_RE = re.compile(r'(python[0-9.]*|py)(\.exe)?')


def hook_entry_command(entry, harness, windows):
    """The command a hook entry runs: on Windows codex prefers its commandWindows."""
    if not isinstance(entry, dict):
        return None
    if windows and harness == 'codex' and isinstance(entry.get('commandWindows'), str):
        return entry['commandWindows']
    return entry.get('command')


def kb_hook_program(entry, event, harness, windows):
    """The program words (kb, or python and kb) of a hook entry that runs
    `kb hook <event> --harness <harness>` with kb at any path; None for any other entry."""
    cmd = hook_entry_command(entry, harness, windows)
    if not isinstance(cmd, str):
        return None
    try:
        words = [w.strip('"\'') for w in shlex.split(cmd, posix=os.name != 'nt')]
    except ValueError:
        return None
    if windows and harness == 'codex' and words[:1] == ['&']:  # see Setup.hook_command
        words = words[1:]

    def base(word):
        return re.split(r'[\\/]', word)[-1].lower()
    n = 2 if words and PYTHON_RE.fullmatch(base(words[0])) else 1
    if len(words) < n + 2 or base(words[n - 1]) not in ('kb', 'kb.cmd') \
            or words[n:n + 2] != ['hook', event]:
        return None
    rest = words[n + 2:]
    if not any(rest[i:i + 2] == ['--harness', harness] for i in range(len(rest))) \
            and '--harness=%s' % harness not in rest:
        return None
    return words[:n]


def missing_program(words):
    """The first program word that names no executable file (after ~ expansion), or None."""
    for word in words:
        path = os.path.expanduser(word)
        if re.search(r'[\\/]', path):
            ok = os.path.isfile(path) and (os.name == 'nt' or os.access(path, os.X_OK))
        else:
            ok = shutil.which(path) is not None
        if not ok:
            return word
    return None


def backup_file(real):
    """Copy real to a new <real>.bak-<UTC time>[-n]; never overwrites or follows a path."""
    base = '%s.bak-%s' % (real, now().replace(':', '').replace('-', ''))
    for n in range(1000):
        name = base if n == 0 else '%s-%d' % (base, n)
        try:
            fd = os.open(name, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
        except FileExistsError:
            continue
        with os.fdopen(fd, 'wb') as out, open(real, 'rb') as src:
            shutil.copyfileobj(src, out)
        shutil.copymode(real, name)
        return name
    raise Rejected('no free backup name for %s' % real)


def replace_file(path, text, old):
    """Write text to path atomically; an existing old content is backed up first.

    Returns the backup's path, or None."""
    real = os.path.realpath(path)  # a symlinked file stays a symlink
    os.makedirs(os.path.dirname(real), exist_ok=True)
    backup = backup_file(real) if old is not None else None
    write_atomic(real, text, real if old is not None else None)
    return backup


def read_or_none(path):
    try:
        with open(path, encoding='utf-8', newline='') as f:
            return f.read()
    except FileNotFoundError:
        return None


GENERATED = '<generated on the real run>'


class Setup:
    """The actions of one kb setup run; each is printed, none is written with --dry-run."""

    def __init__(self, dry_run):
        self.dry = dry_run
        self.refused = 0
        self.home = os.path.expanduser('~')
        self.kb = os.path.realpath(__file__)
        self.repo = os.path.dirname(self.kb)
        self.windows = os.name == 'nt'
        self.cmd_ok = False  # Windows: kb.cmd on the PATH was written or verified by this run

    def home_path(self, *parts):
        return os.path.join(self.home, *parts)

    def do(self, message):
        """Print an action; True when it is to be carried out (no dry run)."""
        print(('would %s' if self.dry else '%s') % message)
        return not self.dry

    def ok(self, message):
        print('ok: %s' % message)

    def refuse(self, message):
        self.refused += 1
        print('refused: %s' % message)

    # 1. config and guest key
    def config(self, role, dest):
        values = read_config()
        path = config_path()
        if os.path.islink(path):
            self.refuse('config %s is a symlink; kb setup writes only a regular file there'
                        % path)
            return
        board = self.board_path()
        if role == 'guest' and os.path.isfile(board):
            self.refuse('this installation holds a board (%s); move it away or run kb setup'
                        ' --host' % board)
            return
        inst = values.get('KB_INSTALLATION', '')
        env_inst = (os.environ.get('KB_INSTALLATION') or '').strip()
        if env_inst and env_inst != inst:  # setting() would use the environment's id
            self.refuse('KB_INSTALLATION=%s in the environment conflicts with %s in %s; unset'
                        ' it or make both the same' % (env_inst, inst or 'none', path))
            return
        if inst and not INSTALLATION_RE.fullmatch(inst):
            self.refuse('KB_INSTALLATION in %s is not 16 lowercase hex digits: %r' % (path, inst))
            return
        recorded = self.board_installation() if role == 'host' else ''
        if inst and recorded and inst != recorded:
            self.refuse('KB_INSTALLATION=%s in %s does not match the board %s, which records %s'
                        % (inst, path, board, recorded))
            return
        if inst:
            self.ok('KB_INSTALLATION=%s in %s' % (inst, path))
        else:
            # A dry run prints no random id: the real run draws its own.
            inst = recorded or (GENERATED if self.dry else secrets.token_hex(8))
            if self.do('write KB_INSTALLATION=%s to %s' % (inst, path)):
                write_config('KB_INSTALLATION', inst)
        host = values.get('KB_HOST', '')
        if role == 'host':
            if host:
                self.refuse('%s sets KB_HOST=%s (a guest); remove that line to make this'
                            ' machine the board host' % (path, host))
            return
        if not dest or dest.startswith('-') or any(c.isspace() for c in dest):
            self.refuse('invalid ssh destination %r' % dest)
            return
        if host == dest:
            self.ok('KB_HOST=%s in %s' % (host, path))
        elif host:
            self.refuse('%s already sets KB_HOST=%s; edit that line to change the board host'
                        % (path, host))
            return
        elif self.do('write KB_HOST=%s to %s' % (dest, path)):
            write_config('KB_HOST', dest)
        key = values.get('KB_SSH_KEY', '')
        if key:
            self.ok('KB_SSH_KEY=%s in %s' % (key, path))
        else:
            key = self.home_path('.ssh', 'kb_guest_%s' % (
                '<installation id>' if inst == GENERATED else inst))
            if self.do('write KB_SSH_KEY=%s to %s' % (key, path)):
                write_config('KB_SSH_KEY', key)
        key = os.path.expanduser(key)
        if os.path.lexists(key) and os.path.lexists(key + '.pub'):
            problem = self.key_problem(key)
            if problem:
                self.refuse('guest key %s: %s' % (key, problem))
                return
            self.ok('guest key %s' % key)
        elif os.path.lexists(key) or os.path.lexists(key + '.pub'):
            self.refuse('only one of %s and %s.pub exists; restore or remove it' % (key, key))
            return
        elif self.do('generate the guest key %s (ed25519, no passphrase)' % key):
            if not os.path.isdir(os.path.dirname(key)):
                os.makedirs(os.path.dirname(key), mode=0o700)
            r = subprocess.run(['ssh-keygen', '-q', '-t', 'ed25519', '-N', '', '-f', key,
                                '-C', 'kb-guest'], stdin=subprocess.DEVNULL)
            if r.returncode != 0:
                self.refuse('ssh-keygen exited %d for %s' % (r.returncode, key))
                return
        self.authorize_line(inst, key + '.pub')

    def key_problem(self, key):
        """Why an existing guest key cannot be used as it is; None when it can."""
        st = os.lstat(key)
        if not stat.S_ISREG(st.st_mode):
            return 'not a regular file (a symlink or other); use a real key file'
        if not self.windows and st.st_mode & 0o077:
            return 'mode %03o; run chmod 600 on it' % (st.st_mode & 0o777)
        try:
            r = subprocess.run(['ssh-keygen', '-y', '-P', '', '-f', key], stdin=subprocess.DEVNULL,
                               stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                               universal_newlines=True, timeout=10)
        except (OSError, subprocess.SubprocessError) as e:
            return 'cannot run ssh-keygen: %s' % e
        if r.returncode != 0:
            return 'ssh-keygen -y cannot read it without a passphrase'
        pub = (read_or_none(key + '.pub') or '').split()[:2]
        if r.stdout.split()[:2] != pub or len(pub) != 2:
            return '%s.pub does not hold its public key' % key
        return None

    @staticmethod
    def board_path():
        return os.path.abspath(os.path.expanduser(os.environ.get('KB_DB') or DEFAULT_DB))

    def board_installation(self):
        """The id an existing board recorded, so a lost config does not split identities."""
        path = self.board_path()
        if not os.path.isfile(path):
            return ''
        try:
            conn = sqlite3.connect('file:%s?mode=ro' % urllib.parse.quote(path), uri=True)
            try:
                row = conn.execute("SELECT value FROM meta WHERE key='installation'").fetchone()
            finally:
                conn.close()
        except sqlite3.DatabaseError:
            return ''
        return row[0] if row and INSTALLATION_RE.fullmatch(row[0]) else ''

    def authorize_line(self, inst, pub):
        """The one command the curator runs on the host to let this guest's key in."""
        label = re.sub(r'[^A-Za-z0-9._-]', '-', socket.gethostname().split('.')[0])[:40] \
            or 'guest'
        words = (read_or_none(pub) or '').split()[:2]
        if len(words) == 2 and KEY_TYPE_RE.fullmatch(words[0]) \
                and KEY_BLOB_RE.fullmatch(words[1]):
            key = "'%s %s'" % tuple(words)  # type and base64 only: nothing a shell expands
        else:
            key = GENERATED  # dry run: the key does not exist yet
        if GENERATED in (key, inst):
            print('the real run prints the kb authorize line the curator runs on the board'
                  ' host; its id and key are generated then')
            return
        print('the curator runs this on the board host (curator session via KB_SESSION):')
        print("printf '%%s\\n' %s | kb authorize --installation %s --label %s -"
              % (key, inst, label))

    # 2. kb on the PATH
    def kb_command(self):
        """How hooks call kb, as words: the PATH entry setup made or verified, else kb itself."""
        if self.windows:
            if self.cmd_ok:
                return [self.home_path('.local', 'bin', 'kb.cmd')]
            return [sys.executable, self.kb]
        link = self.home_path('.local', 'bin', 'kb')
        return [link if os.path.realpath(link) == self.kb else self.kb]

    def path_entry(self):
        bindir = self.home_path('.local', 'bin')
        if self.windows:
            cmd = os.path.join(bindir, 'kb.cmd')
            text = '@"%s" "%s" %%*\r\n' % (sys.executable, self.kb)
            bad = [p for p in (sys.executable, self.kb) if '%' in p or '"' in p]
            if bad:
                self.refuse('%s holds %% or ", which cmd.exe would change in %s; move it to'
                            ' another path' % (bad[0], cmd))
                self.cmd_ok = False
            else:
                self.cmd_ok = self.write_file(cmd, text, replace=False) \
                    or read_or_none(cmd) == text or (self.dry and not os.path.lexists(cmd))
        else:
            self.link(os.path.join(bindir, 'kb'), self.kb)
        dirs = [os.path.normcase(os.path.realpath(os.path.expanduser(d)))
                for d in os.environ.get('PATH', '').split(os.pathsep) if d]
        if os.path.normcase(os.path.realpath(bindir)) not in dirs:
            print('warning: %s is not on PATH; add it in your shell profile' % bindir)

    def link(self, path, target):
        """A symlink (a directory junction on Windows) at path to target; never replaces."""
        if os.path.lexists(path):
            if os.path.exists(path) and os.path.realpath(path) == os.path.realpath(target):
                self.ok('%s -> %s' % (path, target))
            elif os.path.isdir(path) and not os.path.islink(path):
                self.refuse('%s is a directory, not a link to %s; move it away' % (path, target))
            else:
                self.refuse('%s exists and is not a link to %s; move it away' % (path, target))
            return
        if not self.do('link %s -> %s' % (path, target)):
            return
        os.makedirs(os.path.dirname(path), exist_ok=True)
        if self.windows and os.path.isdir(target):  # a junction needs no admin rights
            try:
                import _winapi
                _winapi.CreateJunction(os.path.abspath(target), os.path.abspath(path))
            except (ImportError, AttributeError, OSError) as e:
                self.refuse('cannot create the junction %s -> %s: %s' % (path, target, e))
        else:
            os.symlink(target, path)

    # 3. skill links
    def skills(self):
        agents = self.home_path('.agents', 'skills', 'using-kb')
        self.link(agents, os.path.join(self.repo, 'skills', 'using-kb'))
        if os.path.isdir(self.home_path('.claude')):
            self.link(self.home_path('.claude', 'skills', 'using-kb'), agents)
        else:
            print('skip: %s does not exist (no Claude Code)' % self.home_path('.claude'))

    # 4. Board line in the global instruction files
    def codex_home(self):
        return os.path.expanduser(os.environ.get('CODEX_HOME') or self.home_path('.codex'))

    def board_line(self):
        claude = self.home_path('.claude', 'CLAUDE.md')
        seen, files = set(), []
        for path in (claude, os.path.join(self.codex_home(), 'AGENTS.md'),
                     self.home_path('.pi', 'agent', 'AGENTS.md')):
            real = os.path.realpath(path)
            if real in seen:
                continue
            seen.add(real)
            if not os.path.isdir(os.path.dirname(path)):
                print('skip: %s does not exist' % os.path.dirname(path))
                continue
            files.append((path, real))
        for path, real in files:  # each of these has or gets the Board line
            old = read_or_none(real)
            text = old or ''
            imported = self.imported(path, text, {r for _, r in files if r != real}) \
                if path == claude else None  # only Claude Code follows @ imports
            has = any(line.strip() == BOARD_LINE for line in text.splitlines())
            if has and imported:  # Claude reads it twice; the user's file stays as it is
                print('note: %s has the Board line and also imports %s, which has it; remove'
                      ' it from %s' % (path, imported, path))
            elif has:
                self.ok('Board line in %s' % path)
            elif imported:
                self.ok('%s imports %s' % (path, imported))
            elif self.do('append the Board line to %s' % path):
                self.backed_up(replace_file(
                    real, text + ('\n' if text and not text.endswith('\n') else '')
                    + BOARD_LINE + '\n', old))

    @staticmethod
    def imported(path, text, targets):
        """The first @<path> import line of text that resolves to one of targets, or None."""
        for line in text.splitlines():
            m = re.fullmatch(r'@(\S+)', line.strip())
            if m:
                target = os.path.join(os.path.dirname(path), os.path.expanduser(m.group(1)))
                if os.path.realpath(target) in targets:
                    return target
        return None

    # 5. hooks
    def write_file(self, path, text, replace=True):
        """Write path if its content differs, the old one kept as path.bak; True if written."""
        old = read_or_none(os.path.realpath(path))
        if old == text:
            self.ok('%s is current' % path)
            return False
        if old is not None and not replace:
            self.refuse('%s exists with other content; move it away' % path)
            return False
        if not self.do('write %s' % path):
            return False
        self.backed_up(replace_file(path, text, old))
        return True

    def backed_up(self, backup):
        if backup:
            print('  backup of the old one: %s' % backup)

    def pi_extension(self):
        agent = self.home_path('.pi', 'agent')
        if not os.path.isdir(agent):
            print('skip: %s does not exist (no pi)' % agent)
            return
        with open(os.path.join(self.repo, 'hooks', 'pi', 'kb.ts'), encoding='utf-8') as f:
            text = f.read().replace(PI_KB_PLACEHOLDER, json.dumps(self.kb_command()))
        target = os.path.join(agent, 'extensions', 'kb.ts')
        old = read_or_none(os.path.realpath(target))
        if os.path.islink(target):
            self.refuse('%s is a symlink; kb setup never writes through it. Replace it with'
                        ' a copy of %s or remove it' % (target, os.path.join(
                            self.repo, 'hooks', 'pi', 'kb.ts')))
        elif old is not None and old != text and not old.startswith(PI_MARK):
            self.refuse('%s was not installed by kb setup; merge %s into it by hand, or move it'
                        ' away and run kb setup again'
                        % (target, os.path.join(self.repo, 'hooks', 'pi', 'kb.ts')))
        else:
            self.write_file(target, text)
        try:
            with open(os.path.join(agent, 'settings.json'), encoding='utf-8') as f:
                listed = json.load(f).get('extensions') or []
        except (OSError, ValueError, AttributeError):
            listed = []
        if '+extensions/kb.ts' not in listed:
            print('note: if pi does not load the extension, add "+extensions/kb.ts" to'
                  ' "extensions" in %s' % os.path.join(agent, 'settings.json'))

    def hook_command(self, event, harness):
        """The hook's command line; UsageError for a Windows path that cannot be quoted.
        codex runs a Windows hook through PowerShell, which needs the call operator & to run a
        quoted program and ends a string at a typographic double quote too. Git Bash (Claude
        Code) and PowerShell both expand $ and ` inside double quotes."""
        powershell = self.windows and harness == 'codex'

        def quote(word):
            if not self.windows:
                return shlex.quote(word)
            bad = '"%$`\u201c\u201d\u201e' if powershell else '"%$`'
            if any(c in word for c in bad):
                raise UsageError('path %s holds one of %s, which a Windows hook command cannot'
                                 ' quote; move kb or Python to another path'
                                 % (word, ' '.join(bad)))
            return '"%s"' % word
        return '%s%s hook %s --harness %s' % ('& ' if powershell else '',
                                               ' '.join(map(quote, self.kb_command())), event,
                                               harness)

    def harness_hooks(self, harness, path):
        """Merge the missing kb hook events into a Claude Code or codex hooks file."""
        if not os.path.isdir(os.path.dirname(path)):
            print('skip: %s does not exist (no %s)' % (os.path.dirname(path), harness))
            return False
        try:
            snippet = {'hooks': {name: [dict(
                {'matcher': HOOK_MATCHERS[event]} if event in HOOK_MATCHERS else {},
                hooks=[{'type': 'command', 'command': self.hook_command(event, harness),
                        'timeout': HOOK_TIMEOUTS[harness][event]}])]
                for event, name in HOOK_NAMES}}
        except UsageError as e:
            self.refuse('%s: %s' % (path, e))
            return False
        old = read_or_none(os.path.realpath(path))
        try:
            data = {} if old is None else json.loads(old)
            error = None
        except ValueError as e:
            data, error = None, 'invalid JSON: %s' % e
        hooks = data.setdefault('hooks', {}) if isinstance(data, dict) else None
        if error is None and not (isinstance(hooks, dict)
                                  and all(isinstance(v, list) for v in hooks.values())):
            error = 'no "hooks" object of event lists'
        if error:
            self.refuse('%s: %s; add these entries by hand:\n%s'
                        % (path, error, json.dumps(snippet, indent=2)))
            return False
        added, refused = [], self.refused
        for event, name in HOOK_NAMES:
            groups = hooks.setdefault(name, [])
            found = [(hook_entry_command(h, harness, self.windows), prog) for g in groups
                     if isinstance(g, dict) and isinstance(g.get('hooks'), list)
                     for h in g['hooks']
                     for prog in [kb_hook_program(h, event, harness, self.windows)] if prog]
            if any(missing_program(prog) is None for _, prog in found):
                continue
            if found:  # only stale ones: the harness would run a kb that is gone
                cmd, prog = found[0]
                self.refuse('%s: the %s hook runs `%s`, but %s is not an executable file;'
                            ' fix or remove'
                            ' that entry and run kb setup again'
                            % (path, name, cmd, missing_program(prog)))
                continue
            groups.extend(snippet['hooks'][name])
            added.append(name)
        if not added:
            if self.refused == refused:
                self.ok('kb hooks in %s' % path)
            return False
        if not self.do('add the kb hooks %s to %s' % (', '.join(added), path)):
            return False
        self.backed_up(replace_file(path, json.dumps(data, indent=2, ensure_ascii=False) + '\n',
                                    old))
        return True

    def hooks(self):
        self.pi_extension()
        self.harness_hooks('claude', self.home_path('.claude', 'settings.json'))
        if self.harness_hooks('codex', os.path.join(self.codex_home(), 'hooks.json')):
            print('note: codex runs the changed hooks only after you trust them in its TUI')


def cmd_setup(args):
    """Install kb for this user: config, PATH, skill, Board line and hooks; idempotent."""
    if args.guest is not None:
        role, dest = 'guest', args.guest.strip()
    elif args.host:
        role, dest = 'host', ''
    elif sys.stdin is not None and sys.stdin.isatty():
        role = input('Is this machine the board host or a guest? [host/guest] ').strip()
        if role not in ('host', 'guest'):
            raise UsageError('answer host or guest')
        dest = input('ssh destination of the board host: ').strip() if role == 'guest' else ''
    else:
        raise UsageError('setup needs --host or --guest <ssh-dest> without a terminal')
    s = Setup(args.dry_run)
    print('kb setup as %s%s, kb at %s%s' % (role, ' of %s' % dest if dest else '', s.kb,
                                             ' (dry run: nothing is written)' if s.dry else ''))
    s.config(role, dest)
    s.path_entry()
    s.skills()
    s.board_line()
    s.hooks()
    if s.refused:
        print('%d step(s) refused; fix them and run kb setup again' % s.refused)
        return EXIT_REJECTED
    return EXIT_OK


# --- argument parsing -------------------------------------------------------

class Parser(argparse.ArgumentParser):
    def error(self, message):
        sys.stderr.write('kb: %s\n' % message)
        sys.exit(EXIT_USAGE)


class VersionAction(argparse.Action):
    """--version; asks git only when given, not on every kb call."""
    def __init__(self, option_strings, dest, help=None):
        super().__init__(option_strings, dest, nargs=0, default=argparse.SUPPRESS, help=help)

    def __call__(self, parser, namespace, values, option_string=None):
        print(version_text())
        parser.exit()


HELP = """\
Shared board for agent sessions. Ticket data lives in $KB_DB
(default ~/.local/share/agent-kanban/board.sqlite), never inside a git working tree.

Identity, in this order: --session <token> (from `kb start --as <name>`), the harness's own
session id (CLAUDE_CODE_SESSION_ID, CODEX_SESSION_ID, PI_SESSION_ID; if several are set, pick
one with --harness claude|codex|pi), or KB_SESSION. A harness session unknown to kb is registered
on first use, named after its git repository or directory; `kb start --as <name>` renames it.
Without any of these, run `kb start --as <name>` and pass its token. Note text is read from stdin.
`kb whoami` shows the calling session; `kb sessions` lists the names to address requests to.

Hooks: `kb hook start|stop|end --harness <h>` records session start, activity and end; it
always exits 0 and prints nothing, and logs errors to hook-errors.log next to the database.
On a guest a hook has a deadline (KB_HOOK_DEADLINE, 1 s); an event it cannot deliver goes to
the spool next to hook-errors.log, sent with later hooks or by `kb spool --drain`.
`kb hook prompt --harness <h>` prints, once per session name, new requests addressed to the
session and new replies to its requests; the harness adds that text to the prompt's context.
`kb hook guard --harness <h>` (PreToolUse on the Bash tool) adds a one-line warning to the
model's context when a shell call runs git commit, merge or push or docker compose up while
the session holds no doing or blocked ticket; it never blocks the call.

Setup: `kb setup --host` or `kb setup --guest <ssh-dest>` (install.sh runs it; on Windows
`py -3 <repo>\\kb setup ...`) writes the config and a guest's ssh key, links kb onto PATH and
the using-kb skill, adds the Board line and the hooks; it is idempotent, --dry-run writes nothing.

Curator: a session started with --as curator is the curator. This is advisory and assumes a
single-curator setup; kb does not authenticate who starts a curator session.

Exit codes: 0 ok, 1 rejected by a rule or lost race, 2 needs confirmation (--new),
3 usage or identity error.
"""


def build_parser():
    p = Parser(prog='kb', description=HELP, formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument('--version', action=VersionAction,
                   help="show kb's release and, in a git checkout, its commit")
    sub = p.add_subparsers(dest='command', metavar='command')
    sub.required = True

    ident = Parser(add_help=False)
    ident.add_argument('--session', help='session token from kb start (or KB_SESSION)')
    ident.add_argument('--harness', choices=HARNESSES,
                       help='which harness session id to use when several are set')
    where = Parser(add_help=False)
    where.add_argument('--worktree', help='override the detected git worktree')
    where.add_argument('--branch', help='override the detected git branch')
    text = Parser(add_help=False)
    text.add_argument('--stdin', action='store_true', help='read an optional note from stdin')

    def cmd(name, func, help, parents=(), ticket=False):
        s = sub.add_parser(name, help=help, parents=list(parents))
        if ticket:
            s.add_argument('id', type=int, help='ticket id')
        s.set_defaults(func=func)
        return s

    s = cmd('start', cmd_start, 'register this session and print its token', [where])
    s.add_argument('--as', dest='name', required=True, help='session name, e.g. partflow')
    s.add_argument('--harness', default='',
                   help='claude, codex, pi, ...; picks the harness session id when several are set')

    s = cmd('add', cmd_add, 'add a task (claimed by you) or a request', [ident, where, text])
    s.add_argument('title')
    s.add_argument('--type', choices=('task', 'request'), default='task')
    s.add_argument('--to', help='request addressee: a session name or any')
    s.add_argument('--repo', help='default: the repository of the worktree for tasks, empty for requests')
    s.add_argument('--label', action='append', default=[], help='e.g. needs-curator (repeatable)')
    s.add_argument('--merge-target', default='', help='branch the work merges into')
    s.add_argument('--new', action='store_true', help='add despite similar open tickets')

    cmd('claim', cmd_claim, 'claim a todo ticket', [ident, where], ticket=True)
    cmd('block', cmd_block, 'doing -> blocked (assignee)', [ident, text], ticket=True)
    cmd('resume', cmd_resume, 'blocked -> doing (assignee)', [ident, text], ticket=True)
    cmd('release', cmd_release, 'give a claim back to todo (assignee or curator)',
        [ident, text], ticket=True)
    s = cmd('close', cmd_close, 'close with the closing lines on stdin', [ident], ticket=True)
    s.add_argument('--force', action='store_true', help='curator: close a ticket owned by another')
    cmd('abandon', cmd_abandon, 'todo -> abandoned (opener or curator)', [ident, text], ticket=True)
    cmd('reopen', cmd_reopen, 'done/abandoned -> todo (opener or curator)', [ident, text],
        ticket=True)
    s = cmd('note', cmd_note, 'append a note from stdin', [ident], ticket=True)
    s.add_argument('--kind', choices=('comment', 'request', 'reply'), default='comment')
    cmd('touch', cmd_touch, 'record activity on your ticket', [ident], ticket=True)
    cmd('session-ended', cmd_session_ended, 'note session end on all your open tickets', [ident])
    sub.add_parser('hook', help='harness hook: kb hook start|stop|end --harness <h>',
                   add_help=False)  # dispatched by main to hook_main

    s = cmd('board', cmd_board, 'show open tickets by status and repo', [ident])
    s.add_argument('--repo')
    s.add_argument('--mine', action='store_true', help='only tickets you hold or opened')
    s.add_argument('--to', help='only requests addressed to this name, e.g. curator')
    s.add_argument('--label', help='only tickets with this label, e.g. approval')
    s.add_argument('--all', action='store_true', help='include done and abandoned')
    cmd('show', cmd_show, 'show a ticket and its notes', ticket=True)
    s = cmd('sessions', cmd_sessions, 'session names seen in the last %d days or holding a'
            ' ticket, last seen first (read-only)' % KNOWN_DAYS)
    s.add_argument('--all', action='store_true', help='every current session name')
    cmd('whoami', cmd_whoami, 'show the calling session, never its token (read-only)', [ident])

    s = cmd('backup', cmd_backup, 'write a consistent copy of the database')
    s.add_argument('path')
    s = cmd('restore', cmd_restore, 'curator: restore a backup and block claims', [ident])
    s.add_argument('path')
    s = cmd('recover', cmd_recover, 'curator: lift the block after reconciling', [ident])
    s.add_argument('--done', action='store_true')
    s = cmd('report', cmd_report, 'P3 measurement: board use per session, tickets, duplicates'
            ' (read-only)')
    s.add_argument('--since', help='window start, YYYY-MM-DD (UTC); default: --days before now')
    s.add_argument('--days', type=int, help='window length in days (default %d)' % REPORT_DAYS)
    s = cmd('spool', cmd_spool, 'guest: count the hook events not yet delivered to the host')
    s.add_argument('--drain', action='store_true', help='send them all now, without deadline')
    s = cmd('serve', cmd_serve, 'host: run one guest request (ssh forced command only)')
    s.add_argument('--installation', required=True, help='the guest key\'s installation id')
    s = cmd('authorize', cmd_authorize, 'curator on the host: let a guest key run kb serve',
            [ident])
    s.add_argument('--installation', required=True, help='the guest\'s installation id')
    s.add_argument('--label', required=True, help='guest name for the key comment')
    s.add_argument('pubkey', help='file holding the guest\'s one public key, - for stdin')
    s = cmd('setup', cmd_setup, 'install kb for this user as board host or guest (local)')
    role = s.add_mutually_exclusive_group()
    role.add_argument('--host', action='store_true', help='this machine holds the board')
    role.add_argument('--guest', metavar='SSH_DEST', help='use the board on this ssh host')
    s.add_argument('--dry-run', action='store_true', help='print the actions, write nothing')
    return p


def run(args):
    """Run a parsed command; its exit code."""
    try:
        code = args.func(args)
    except KbError as e:
        sys.stderr.write('kb: %s\n' % e)
        return e.code
    except sqlite3.OperationalError as e:
        sys.stderr.write('kb: database error: %s\n' % e)
        return EXIT_REJECTED
    return EXIT_OK if code is None else code


def main(argv=None):
    argv = sys.argv[1:] if argv is None else argv
    try:
        host = setting('KB_HOST')
    except (OSError, ValueError) as e:
        if argv[:1] == ['hook']:  # a hook never fails its harness
            log_hook_error(argv[1:], e)
            return EXIT_OK
        sys.stderr.write('kb: cannot read %s: %s\n' % (config_path(), e))
        return EXIT_USAGE
    if argv[:1] == ['hook']:
        return guest_hook(argv[1:], host) if host else hook_main(argv[1:])
    # The spool is the guest's own; setup installs kb on this machine; --version is this kb's.
    if host and argv and argv[0] not in ('-h', '--help', '--version', 'spool', 'setup'):
        return guest_main(argv, host)
    return run(build_parser().parse_args(argv))


if __name__ == '__main__':
    sys.exit(main())
