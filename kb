def now():
    return datetime.datetime.now(datetime.timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ')


def parse_time(s):
    return datetime.datetime.strptime(s, '%Y-%m-%dT%H:%M:%SZ').replace(
        tzinfo=datetime.timezone.utc)


def stale_cutoff():
    """(KB_STALE_HOURS, the time before which waiting or held work counts as stale)."""
    try:  # nan, inf and huge values fail in timedelta or the subtraction
        hours = float(os.environ.get('KB_STALE_HOURS') or 24)
        return hours, (datetime.datetime.now(datetime.timezone.utc)
                       - datetime.timedelta(hours=hours))
    except (ValueError, OverflowError):
        raise UsageError('KB_STALE_HOURS must be a number of hours')


def age(s):
    if not s:
        return '-'
    secs = (datetime.datetime.now(datetime.timezone.utc) - parse_time(s)).total_seconds()
    if secs < 3600:
        return '%dm' % (secs // 60)
    if secs < 86400:
        return '%dh' % (secs // 3600)
    return '%dd' % (secs // 86400)


def git(cwd, *args, timeout=10):
    """Run git; return stripped stdout, or None on any failure."""
    try:
        r = subprocess.run(['git', '-C', cwd] + list(args), stdout=subprocess.PIPE,
                           stderr=subprocess.DEVNULL, universal_newlines=True, timeout=timeout)
    except (OSError, subprocess.SubprocessError, UnicodeDecodeError):
        return None
    return r.stdout.strip() if r.returncode == 0 else None


def version_text():
    """'kb VERSION', plus the commit and -dirty when this file is tracked in a git checkout.
    The running file's blob hash is compared with HEAD's, so index flags such as
    assume-unchanged and staged changes do not matter; an untracked copy has no HEAD blob."""
    d, name = os.path.split(os.path.realpath(__file__))
    deadline = time.monotonic() + 2  # one budget for all calls

    def run(*args):
        left = deadline - time.monotonic()
        return git(d, *args, timeout=left) if left > 0 else None
    commit = run('rev-parse', '--verify', 'HEAD')
    # Both from the one commit resolved above, so a checkout in between cannot mix revisions.
    committed = commit and run('rev-parse', '%s:./%s' % (commit, name))
    head = committed and run('rev-parse', '--short', commit)
    running = head and run('hash-object', '--', name)
    if not running:
        return 'kb %s' % VERSION
    return 'kb %s (%s%s)' % (VERSION, head, '-dirty' if running != committed else '')


def inside_git_tree(path):
    d = path if os.path.isdir(path) else os.path.dirname(os.path.abspath(path))
    return git(d, 'rev-parse', '--is-inside-work-tree') == 'true'


def repo_name(path):
    """Name of the repository that holds path; the main checkout's name for a linked worktree."""
    return repo_from_common(git(path, 'rev-parse', '--path-format=absolute', '--git-common-dir'))


def repo_from_common(common):
    """Repository name from git's common directory (the main checkout's .git, or a bare repo)."""
    if not common:
        return ''
    common = os.path.realpath(common)
    if os.path.basename(common) == '.git':
        return os.path.basename(os.path.dirname(common))
    base = os.path.basename(common)  # bare repository
    return base[:-4] if base.endswith('.git') else base


def exec_meta(args):
    """Host, worktree and branch of the calling session; flags override git.

    For a guest, git ran on the guest (its context); the host never runs git on a guest path.
    """
    worktree = getattr(args, 'worktree', None)
    branch = getattr(args, 'branch', None)
    if GUEST:
        if worktree is None:
            worktree = GUEST['toplevel']
        if branch is None:
            branch = GUEST['branch'] if worktree == GUEST['toplevel'] else ''
        return GUEST['host'], worktree, branch
    if worktree is None:
        worktree = git(os.getcwd(), 'rev-parse', '--show-toplevel') or ''
    if branch is None:
        branch = (git(worktree, 'rev-parse', '--abbrev-ref', 'HEAD') or '') if worktree else ''
    return socket.gethostname(), worktree, branch


# --- configuration and installation id (D9) ---------------------------------

def config_path():
    base = os.environ.get('XDG_CONFIG_HOME') or os.path.join(os.path.expanduser('~'), '.config')
    return os.path.join(base, 'agent-kanban', 'config')


def read_config():
    """KEY=value lines of the config file; `#` starts a comment line."""
    values = {}
    try:
        with open(config_path(), encoding='utf-8') as f:
            for line in f:
                line = line.strip()
                if line and not line.startswith('#') and '=' in line:
                    key, value = line.split('=', 1)
                    values[key.strip()] = value.strip()
    except FileNotFoundError:
        pass
    return values


def setting(key):
    """A config key: the environment beats the file; an empty KB_HOST forces local mode."""
    value = os.environ.get(key)
    if value is not None and (value.strip() or key == 'KB_HOST'):
        return value.strip()
    return read_config().get(key, '')


def write_config(key, value):
    """Append KEY=value to the config file, keeping every other line and its mode."""
    path = config_path()
    if os.path.islink(path):  # os.replace would turn the link into a regular file
        raise UsageError('config %s is a symlink; add %s=%s to its target by hand'
                         % (path, key, value))
    os.makedirs(os.path.dirname(path), mode=0o700, exist_ok=True)
    try:
        with open(path, encoding='utf-8') as f:
            text = f.read()
    except FileNotFoundError:
        text = None
    body = text or ''
    if body and not body.endswith('\n'):
        body += '\n'
    write_atomic(path, '%s%s=%s\n' % (body, key, value), path if text is not None else None)


def write_atomic(path, text, mode_of=None):
    """Replace path with text through a new temp file beside it (mkstemp: exclusive, 0600,
    never an existing path or symlink); mode_of, if given, lends its file mode."""
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path),
                               prefix='.%s.kb-tmp-' % os.path.basename(path))
    try:
        with os.fdopen(fd, 'w', encoding='utf-8', newline='') as f:
            f.write(text)
        if mode_of is not None:
            shutil.copymode(mode_of, tmp)
        os.replace(tmp, path)
    except BaseException:
        with contextlib.suppress(OSError):
            os.remove(tmp)
        raise


_HOST_INSTALLATION = None


def host_installation(conn=None):
    """This machine's installation id: from the config, else the board's record, else new.

    A missing id is written to the config, so every later call returns the same one. An id
    that differs from the board's record is refused: it would split every session's identity.
    """
    global _HOST_INSTALLATION
    row = None
    if conn is not None:
        with contextlib.suppress(sqlite3.OperationalError):  # no meta table yet
            row = conn.execute("SELECT value FROM meta WHERE key='installation'").fetchone()
    if _HOST_INSTALLATION is None:
        inst = setting('KB_INSTALLATION')
        if not inst:
            inst = row[0] if row and INSTALLATION_RE.fullmatch(row[0]) else secrets.token_hex(8)
            write_config('KB_INSTALLATION', inst)
        if not INSTALLATION_RE.fullmatch(inst):
            raise UsageError('KB_INSTALLATION must be 16 lowercase hex digits: %r' % inst)
        _HOST_INSTALLATION = inst
    if row and row[0] != _HOST_INSTALLATION:
        raise UsageError("installation id %s does not match this board's %s"
                         % (_HOST_INSTALLATION, row[0]))
    return _HOST_INSTALLATION


def installation(conn):
    """Installation of the calling session: the guest's in kb serve, else this machine's."""
    return GUEST['inst'] if GUEST else host_installation(conn)


def env(key):
    """An identity variable of the caller: the guest's in kb serve, never the host's own."""
    return (GUEST['env'] if GUEST else os.environ).get(key)


def db_path():
    path = os.path.expanduser(os.environ.get('KB_DB') or DEFAULT_DB)
    os.makedirs(os.path.dirname(os.path.abspath(path)), mode=0o700, exist_ok=True)
    # D8: ticket data never lives inside a git working tree.
    if inside_git_tree(path):
        raise UsageError('database path is inside a git working tree: %s' % path)
    return path


def session_label(name, harness, token):
    # Two sessions may share a name; a short hash of the token tells them apart
    # without printing any part of the token itself.
    if name is None:
        return None
    tag = hashlib.sha256(token.encode()).hexdigest()[:4]
    return '%s%s\u00b7%s' % (name, '/' + harness if harness else '', tag)


def run_script(conn, script, params=None):
    for stmt in script.split(';\n'):
        if stmt.strip():
            conn.execute(stmt, params or {})


def migrate(conn):
    """Bring conn to SCHEMA_VERSION; the caller holds a write transaction."""
    version = conn.execute('PRAGMA user_version').fetchone()[0]
    if version > SCHEMA_VERSION:
        raise UsageError('database schema version %d, kb supports %d'
                         % (version, SCHEMA_VERSION))
    if version == 0:
        run_script(conn, SCHEMA)
        version = 1
    while version < SCHEMA_VERSION:
        params = {'installation': host_installation(conn)} if version == 4 else None
        run_script(conn, MIGRATIONS[version], params)
        version += 1
    conn.execute('PRAGMA user_version=%d' % SCHEMA_VERSION)


def connect(busy_ms=10000):
    conn = sqlite3.connect(db_path(), isolation_level=None)
    conn.create_function('slabel', 3, session_label)
    conn.execute('PRAGMA busy_timeout=%d' % busy_ms)
    conn.execute('PRAGMA journal_mode=WAL')
    conn.execute('PRAGMA foreign_keys=ON')
    if conn.execute('PRAGMA user_version').fetchone()[0] != SCHEMA_VERSION:
        with transaction(conn):
            migrate(conn)
    host_installation(conn)  # refuses a config id that does not match the board
    test_barrier()  # before the first BEGIN
    return conn


def test_barrier():
    """Test hook: line up concurrent processes at one point."""
    barrier = os.environ.get('KB_TEST_BARRIER')
    if barrier:
        open('%s.%d' % (barrier, os.getpid()), 'w').close()
        while not os.path.exists(barrier):
            time.sleep(0.002)


@contextlib.contextmanager
def transaction(conn):
    conn.execute('BEGIN IMMEDIATE')
    try:
        yield
    except BaseException:
        if conn.in_transaction:  # some errors already rolled back inside SQLite
            conn.execute('ROLLBACK')
        raise
    conn.execute('COMMIT')


def read_text(required):
    text = '' if sys.stdin.isatty() else sys.stdin.read()
    if text.startswith('\ufeff'):  # Windows PowerShell 5.1 pipes UTF-8 with a BOM
        text = text[1:]
    if required and not text.strip():
        raise UsageError('note text is required on stdin')
    return text.strip()


def harness_id(pick=None):
    """(harness, id) from the harness session id variables, or None.

    Nested harnesses inherit each other's variables, so several set ones need pick.
    """
    found = [(h, env(v).strip()) for h, v in HARNESS_ENV if (env(v) or '').strip()]
    if pick:
        found = [f for f in found if f[0] == pick]
    elif len(found) > 1:
        raise UsageError('several harness session ids are set (%s); pass --harness <%s>'
                         % (', '.join(v for h, v in HARNESS_ENV if h in dict(found)),
                            '|'.join(h for h, _ in found)))
    return found[0] if found else None


def safe_name(base):
    """A directory or repository name as a session name that never grants curator rights."""
    name = '-'.join(base.split()) or 'session'
    if name in ('any', CURATOR):
        name += '-session'
    return name


def derive_name(cwd):
    """Session name and worktree for an auto-registered session."""
    if GUEST:  # the D4 main-checkout rule ran on the guest
        return safe_name(GUEST['name']), GUEST['toplevel']
    top = git(cwd, 'rev-parse', '--show-toplevel') or ''
    base = repo_name(cwd) or os.path.basename(os.path.abspath(cwd).rstrip('/'))
    return safe_name(base), top


def find_harness_session(conn, inst, harness, hsid):
    return conn.execute('SELECT token, name FROM session WHERE installation=? AND harness=?'
                        ' AND harness_session=?', (inst, harness, hsid)).fetchone()


def insert_harness_session(conn, inst, harness, hsid, name, worktree, t=None, host=None):
    """Inside a write transaction: add the row unless a concurrent call did."""
    t = t or now()
    host = host or (GUEST['host'] if GUEST else socket.gethostname())
    conn.execute('INSERT OR IGNORE INTO session (%s) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)'
                 % SESSION_COLUMNS, (secrets.token_hex(8), name, harness, host,
                                     worktree, t, hsid, t, inst))
    return find_harness_session(conn, inst, harness, hsid)


def register(conn, harness, hsid, cwd):
    """Token and name of the session for a harness id, auto-registering it (D6)."""
    inst = installation(conn)
    row = find_harness_session(conn, inst, harness, hsid)
    if row is None:
        name, worktree = derive_name(cwd)  # git runs outside the write lock
        with transaction(conn):
            row = insert_harness_session(conn, inst, harness, hsid, name, worktree)
    return row


def session(conn, args):
    token = args.session
    if not token:
        # A harness id outranks KB_SESSION, which a nested run may inherit from its parent.
        hid = harness_id(getattr(args, 'harness', None))
        if hid is not None:
            return tuple(register(conn, hid[0], hid[1], os.getcwd()))
        token = env('KB_SESSION')
        if not token:
            raise UsageError('missing session token: pass --session <token> (from kb start)')
    row = conn.execute('SELECT token, name, installation FROM session WHERE token=?',
                       (token,)).fetchone()
    if row is None:
        raise UsageError('unknown session token')
    if GUEST and (row[2] != GUEST['inst'] or row[1] == CURATOR):
        # A guest acts only with its own installation's sessions, and never as the curator.
        raise Rejected('session token rejected: it belongs to another installation'
                       if row[2] != GUEST['inst'] else
                       'session token rejected: the curator acts on the host only')
    return row[0], row[1]


def is_curator(name):
    """Curator rights need the name, a caller on the host itself, and no harness session id."""
    return (name == CURATOR and GUEST is None
            and not any(os.environ.get(v, '').strip() for _, v in HARNESS_ENV))


def describe(conn, ticket_id):
    row = conn.execute(
        'SELECT c.status, slabel(s.name, s.harness, s.token), c.addressee FROM ticket c'
        ' LEFT JOIN session s ON s.token=c.assignee WHERE c.id=?', (ticket_id,)).fetchone()
    if row is None:
        return 'ticket %s does not exist' % ticket_id
    status, holder, addressee = row
    detail = ', held by %s' % holder if holder else ''
    if status == 'todo' and addressee:
        detail = ', addressed to %s' % addressee
    return 'ticket %s is %s%s' % (ticket_id, status, detail)


# action -> (statuses it starts from, who may do it). Used only to explain a rejection;
# the guarded UPDATE of each command is what enforces the rule.
RULES = {
    'claim': (('todo',), 'addressee'),
    'block': (('doing',), 'assignee'),
    'resume': (('blocked',), 'assignee'),
    'release': (('doing', 'blocked'), 'assignee or the curator'),
    'abandon': (('todo',), 'opener or the curator'),
    'reopen': (('done', 'abandoned'), 'opener or the curator'),
    'touch': (('doing', 'blocked'), 'assignee'),
    'close': (('doing', 'blocked'), 'assignee'),
    'close request': (('todo', 'doing', 'blocked'), 'opener or the assignee'),
    'close --force': (('doing', 'blocked'), 'curator'),
}


def reason(conn, ticket_id, action, me=None, name=None):
    """Name the condition that made a guarded transition fail."""
    row = conn.execute('SELECT type, status, assignee, opener, addressee FROM ticket WHERE id=?',
                       (ticket_id,)).fetchone()
    if row is None or action not in RULES or me is None:
        return describe(conn, ticket_id)
    kind, status, assignee, opener, addressee = row
    statuses, actor = RULES[action]
    verb = action.split()[0]
    if status not in statuses:
        return '%s; %s needs %s' % (describe(conn, ticket_id), verb, ' or '.join(statuses))
    if action == 'claim':  # mirrors CLAIM_SQL
        if assignee is not None:
            return ('%s; claim needs a todo ticket without assignee, and this one is still held'
                    % describe(conn, ticket_id))
        if addressee == '':
            return ('%s; its addressee is empty, so no session can claim it'
                    % describe(conn, ticket_id))
        allowed = addressee is None or addressee in ('any', name)
        actor = 'addressee (%s)' % addressee
    elif action == 'close request':
        allowed = me in (opener, assignee)
    elif action == 'close --force':
        if is_curator(name) and assignee is None:
            return '%s; close --force needs a ticket with an assignee' % describe(conn, ticket_id)
        allowed = is_curator(name)
    elif actor.endswith('or the curator'):
        allowed = is_curator(name) or me == (opener if actor.startswith('opener') else assignee)
    else:
        allowed = me == assignee
    if not allowed:
        return 'only the %s may %s %s %s (%s)' % (actor, verb, kind, ticket_id,
                                               describe(conn, ticket_id))
    if action == 'close request' and not conn.execute(
            "SELECT 1 FROM note WHERE ticket_id=? AND kind='reply'", (ticket_id,)).fetchone():
        return ('request %s has no reply note; add one with kb note --kind reply %s'
                % (ticket_id, ticket_id))
    return describe(conn, ticket_id)


def require(conn, ok, ticket_id, action, me=None, name=None):
    if not ok:
        verb = action.split()[0] if action == 'close request' else action
        raise Rejected('%s rejected: %s' % (verb, reason(conn, ticket_id, action, me, name)))


def add_note(conn, ticket_id, author, kind, text, activity=True, t=None):
    t = t or now()
    conn.execute('INSERT INTO note (ticket_id, author, time, kind, text) VALUES (?, ?, ?, ?, ?)',
                 (ticket_id, author, t, kind, text))
    if activity:
        conn.execute('UPDATE ticket SET last_activity=? WHERE id=?', (t, ticket_id))


def recovering(conn):
    return conn.execute("SELECT 1 FROM meta WHERE key='recovery'").fetchone() is not None


def transition(args, action, sql, params, kind, default_text):
    """Guarded status change plus its note, in one IMMEDIATE transaction.

    params(token, name) returns the SQL parameters for the calling session.
    """
    text = read_text(False) if args.stdin else ''
    conn = connect()
    me, name = session(conn, args)
    with transaction(conn):
        cur = conn.execute(sql, params(me, name))
        require(conn, cur.rowcount == 1, args.id, action, me, name)
        add_note(conn, args.id, me, kind, text or default_text)
    print('ticket %d: %s' % (args.id, default_text))


