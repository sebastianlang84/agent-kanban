def cmd_start(args):
    name = args.name.strip()
    if not name or name.split() != [name] or name == 'any':
        raise UsageError('invalid session name: %r' % args.name)
    host, worktree, _ = exec_meta(args)
    hid = harness_id(args.harness if args.harness in HARNESSES else None)
    if name == CURATOR and GUEST:
        raise Rejected('start rejected: the curator acts on the host only')
    conn = connect()
    inst = installation(conn)
    if hid is not None:
        if name == CURATOR:  # agents always carry a harness id; the curator uses a plain shell
            raise Rejected('start rejected: a harness session cannot be the curator')
        # The harness already identifies this session: name (or rename) it.
        with transaction(conn):
            row = insert_harness_session(conn, inst, hid[0], hid[1], name, worktree)
            conn.execute('UPDATE session SET name=?, last_seen=? WHERE token=?',
                         (name, now(), row[0]))
        print(row[0])
        return
    token = secrets.token_hex(8)
    t = now()
    with transaction(conn):
        conn.execute('INSERT INTO session (%s) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)'
                     % SESSION_COLUMNS, (token, name, args.harness, host, worktree, t, '', t, inst))
    print(token)


def cmd_add(args):
    if args.type == 'request' and not args.to:
        raise UsageError('a request needs --to <session name>|any')
    if args.type == 'task' and args.to:
        raise UsageError('--to is only for requests')
    title = args.title.strip()
    if not title:
        raise UsageError('empty title')
    host, worktree, branch = exec_meta(args)
    repo = args.repo
    if repo is None:
        if args.type != 'task' or not worktree:
            repo = ''
        elif GUEST:  # repo_name ran on the guest, for its own toplevel only
            repo = GUEST['repo'] if worktree == GUEST['toplevel'] else ''
        else:
            repo = repo_name(worktree)
    text = read_text(False) if args.stdin else ''
    conn = connect()
    me, _ = session(conn, args)
    labels = ','.join(l.strip() for l in args.label if l.strip())
    t = now()
    with transaction(conn):
        if recovering(conn):
            raise Rejected(RECOVERY)
        if not args.new:
            similar = [r for r in conn.execute(
                'SELECT id, status, title FROM ticket WHERE repo=? AND status IN (?, ?, ?)',
                (repo,) + OPEN)
                if difflib.SequenceMatcher(None, title.lower(), r[2].lower()).ratio()
                >= SIMILARITY]
            if similar:
                for r in similar:
                    print('#%d %s %s' % r)
                raise NeedsConfirm('similar open tickets in repo %r; rerun with --new to add anyway'
                                   % repo)
        if args.type == 'task':
            status, assignee, claimed = 'doing', me, t
        else:
            status, assignee, claimed = 'todo', None, None
            host, worktree, branch = '', '', ''  # execution metadata belongs to the claimer
        cur = conn.execute(
            'INSERT INTO ticket (type, title, repo, status, addressee, assignee, opener, labels,'
            ' created, updated, claimed_at, last_activity, host, worktree, branch, merge_target)'
            ' VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)',
            (args.type, title, repo, status, args.to, assignee, me, labels, t, t, claimed, t,
             host, worktree, branch, args.merge_target))
        ticket_id = cur.lastrowid
        if text:
            add_note(conn, ticket_id, me, 'request' if args.type == 'request' else 'comment', text)
    print(ticket_id)
    if args.to not in (None, 'any', CURATOR) and conn.execute(
            'SELECT 1 FROM session WHERE name=?', (args.to,)).fetchone() is None:
        known = [n['name'] for n in session_names(conn, KNOWN_DAYS)][:KNOWN_MAX]
        sys.stderr.write('kb: no session currently has the name %s; known names: %s\n'
                         % (args.to, ', '.join(known) or '-'))


def cmd_claim(args):
