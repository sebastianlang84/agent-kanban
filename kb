def installation_label(inst, here):
    return 'host' if inst == here else inst


def session_names(conn, days=None):
    """One dict per session name, last seen first; only names seen in the last days if given.

    Last seen is the latest of a session's own start, hook activity, notes and opened tickets;
    a name that holds a doing or blocked ticket is listed however long ago it was seen.
    """
    here = host_installation(conn)
    rows = conn.execute(
        'SELECT s.name, s.harness, s.installation, max(s.started, coalesce(s.last_seen, \'\'),'
        ' coalesce((SELECT max(n.time) FROM note n WHERE n.author=s.token), \'\'),'
        ' coalesce((SELECT max(t.created) FROM ticket t WHERE t.opener=s.token), \'\')),'
        " (SELECT count(*) FROM ticket t WHERE t.assignee=s.token AND t.status='doing'),"
        " (SELECT count(*) FROM ticket t WHERE t.assignee=s.token AND t.status='blocked')"
        ' FROM session s').fetchall()
    names = {}
    for name, harness, inst, seen, doing, blocked in rows:
        n = names.setdefault(name, {'name': name, 'harnesses': set(), 'sessions': 0, 'seen': '',
                                    'doing': 0, 'blocked': 0, 'installations': set()})
        if harness:
            n['harnesses'].add(harness)
        n['sessions'] += 1
        n['seen'] = max(n['seen'], seen)
        n['doing'] += doing
        n['blocked'] += blocked
        n['installations'].add(installation_label(inst, here))
    result = sorted(names.values(), key=lambda n: (n['seen'], n['name']), reverse=True)
    if days is not None:
        cutoff = fmt_time(datetime.datetime.now(datetime.timezone.utc)
                          - datetime.timedelta(days=days))
        result = [n for n in result if n['seen'] >= cutoff or n['doing'] + n['blocked']]
    return result


