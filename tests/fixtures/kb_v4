def cmd_start(args):
    name = args.name.strip()
    if not name or name.split() != [name] or name == 'any':
        raise UsageError('invalid session name: %r' % args.name)
    host, worktree, _ = exec_meta(args)
    hid = harness_id(args.harness if args.harness in HARNESSES else None)
    conn = connect()
    if hid is not None:
        if name == CURATOR:  # agents always carry a harness id; the curator uses a plain shell
            raise Rejected('start rejected: a harness session cannot be the curator')
        # The harness already identifies this session: name (or rename) it.
        with transaction(conn):
            row = insert_harness_session(conn, hid[0], hid[1], name, worktree)
            conn.execute('UPDATE session SET name=?, last_seen=? WHERE token=?',
                         (name, now(), row[0]))
        print(row[0])
        return
    token = secrets.token_hex(8)
    t = now()
    with transaction(conn):
        conn.execute('INSERT INTO session (%s) VALUES (?, ?, ?, ?, ?, ?, ?, ?)' % SESSION_COLUMNS,
                     (token, name, args.harness, host, worktree, t, '', t))
    print(token)


def cmd_add(args):
    if args.type == 'request' and not args.to:
        raise UsageError('a request needs --to <session name>|any')
    if args.type == 'task' and args.to:
        raise UsageError('--to is only for requests')
    title = args.title.strip()
    if not title:
        raise UsageError('empty title')
    host, worktree, branch = exec_meta(args)
    repo = args.repo
    if repo is None:
        repo = repo_name(worktree) if args.type == 'task' and worktree else ''
    text = read_text(False) if args.stdin else ''
    conn = connect()
    me, _ = session(conn, args)
    labels = ','.join(l.strip() for l in args.label if l.strip())
    t = now()
    with transaction(conn):
        if recovering(conn):
            raise Rejected(RECOVERY)
        if not args.new:
            similar = [r for r in conn.execute(
                'SELECT id, status, title FROM ticket WHERE repo=? AND status IN (?, ?, ?)',
                (repo,) + OPEN)
                if difflib.SequenceMatcher(None, title.lower(), r[2].lower()).ratio()
                >= SIMILARITY]
            if similar:
                for r in similar:
                    print('#%d %s %s' % r)
                raise NeedsConfirm('similar open tickets in repo %r; rerun with --new to add anyway'
                                   % repo)
        if args.type == 'task':
            status, assignee, claimed = 'doing', me, t
        else:
            status, assignee, claimed = 'todo', None, None
            host, worktree, branch = '', '', ''  # execution metadata belongs to the claimer
        cur = conn.execute(
            'INSERT INTO ticket (type, title, repo, status, addressee, assignee, opener, labels,'
            ' created, updated, claimed_at, last_activity, host, worktree, branch, merge_target)'
            ' VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)',
            (args.type, title, repo, status, args.to, assignee, me, labels, t, t, claimed, t,
             host, worktree, branch, args.merge_target))
        ticket_id = cur.lastrowid
        if text:
            add_note(conn, ticket_id, me, 'request' if args.type == 'request' else 'comment', text)
    print(ticket_id)


def cmd_claim(args):
    host, worktree, branch = exec_meta(args)
    conn = connect()
    me, name = session(conn, args)
    t = now()
    params = (me, t, t, t, host, worktree, branch, args.id, name)
    with transaction(conn):
        if recovering(conn):
            raise Rejected(RECOVERY)
        cur = conn.execute(CLAIM_SQL, params)
        require(conn, cur.rowcount == 1, args.id, 'claim', me, name)
        add_note(conn, args.id, me, 'comment', 'claimed')
    print('ticket %d: claimed' % args.id)


def cmd_block(args):
    transition(args, 'block',
               "UPDATE ticket SET status='blocked', updated=? WHERE id=? AND status='doing'"
               " AND assignee=?",
               lambda me, name: (now(), args.id, me), 'comment', 'blocked')


def cmd_resume(args):
    transition(args, 'resume',
               "UPDATE ticket SET status='doing', updated=? WHERE id=? AND status='blocked'"
               " AND assignee=?",
               lambda me, name: (now(), args.id, me), 'comment', 'resumed')


def cmd_release(args):
    transition(args, 'release',
               "UPDATE ticket SET status='todo', assignee=NULL, claimed_at=NULL, updated=?"
               " WHERE id=? AND status IN ('doing', 'blocked') AND (assignee=? OR ?)",
               lambda me, name: (now(), args.id, me, is_curator(name)), 'release', 'released')


def cmd_abandon(args):
    transition(args, 'abandon',
               "UPDATE ticket SET status='abandoned', updated=? WHERE id=? AND status='todo'"
               " AND (opener=? OR ?)",
               lambda me, name: (now(), args.id, me, is_curator(name)), 'comment', 'abandoned')


def cmd_reopen(args):
    transition(args, 'reopen',
               "UPDATE ticket SET status='todo', assignee=NULL, claimed_at=NULL, updated=?"
               " WHERE id=? AND status IN ('done', 'abandoned') AND (opener=? OR ?)",
               lambda me, name: (now(), args.id, me, is_curator(name)), 'comment', 'reopened')


def cmd_close(args):
    conn = connect()
    me, name = session(conn, args)
    text = read_text(True)
    t = now()
    with transaction(conn):
        row = conn.execute('SELECT type FROM ticket WHERE id=?', (args.id,)).fetchone()
        require(conn, row is not None, args.id, 'close')
        if args.force:
            if not is_curator(name):
                raise Rejected('close --force rejected: curator only')
            cur = conn.execute(
                "UPDATE ticket SET status='done', updated=? WHERE id=?"
                " AND status IN ('doing', 'blocked') AND assignee IS NOT NULL", (t, args.id))
            kind = 'force-close'
            action = 'close --force'
        elif row[0] == 'task':
            cur = conn.execute(
                "UPDATE ticket SET status='done', updated=? WHERE id=?"
                " AND status IN ('doing', 'blocked') AND assignee=?", (t, args.id, me))
            kind = 'close'
            action = 'close'
        else:
            # A request closes once it has a reply, by its opener or its assignee (D3).
            cur = conn.execute(
                "UPDATE ticket SET status='done', updated=? WHERE id=?"
                " AND status IN ('todo', 'doing', 'blocked') AND (opener=? OR assignee=?)"
                " AND EXISTS (SELECT 1 FROM note WHERE ticket_id=ticket.id AND kind='reply')",
                (t, args.id, me, me))
            kind = 'close'
            action = 'close request'
        require(conn, cur.rowcount == 1, args.id, action, me, name)
        add_note(conn, args.id, me, kind, text)
    print('ticket %d: done' % args.id)


def cmd_note(args):
    conn = connect()
    me, _ = session(conn, args)
    text = read_text(True)
    with transaction(conn):
        cur = conn.execute('UPDATE ticket SET updated=? WHERE id=?', (now(), args.id))
        require(conn, cur.rowcount == 1, args.id, 'note')
        add_note(conn, args.id, me, args.kind, text)
    print('ticket %d: %s noted' % (args.id, args.kind))


def cmd_touch(args):
    conn = connect()
    me, name = session(conn, args)
    with transaction(conn):
        cur = conn.execute("UPDATE ticket SET last_activity=? WHERE id=? AND assignee=?"
                           " AND status IN ('doing', 'blocked')", (now(), args.id, me))
        require(conn, cur.rowcount == 1, args.id, 'touch', me, name)
    print('ticket %d: touched' % args.id)


def note_session_ended(conn, me):
    """Inside a write transaction: session-ended note on the session's owned tickets."""
    ids = [r[0] for r in conn.execute(
        "SELECT id FROM ticket WHERE assignee=? AND status IN ('doing', 'blocked')", (me,))]
    for ticket_id in ids:
        # Written by a hook, not by work: does not count as activity.
        add_note(conn, ticket_id, me, 'session-ended', 'session ended', activity=False)
    return len(ids)


def cmd_session_ended(args):
    conn = connect()
    me, _ = session(conn, args)
    with transaction(conn):
        n = note_session_ended(conn, me)
    print('session-ended noted on %d ticket(s)' % n)


