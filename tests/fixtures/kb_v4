def cmd_restore(args):
    conn = connect()
    _, name = session(conn, args)
    if not is_curator(name):
        raise Rejected('restore rejected: curator only')
    if not os.path.isfile(args.path):
        raise UsageError('no such backup file: %s' % args.path)
    # Block claims first: one landing while the image is prepared would vanish in the copy.
    with transaction(conn):
        conn.execute("INSERT OR REPLACE INTO meta VALUES ('recovery', ?)", (now(),))
    src = sqlite3.connect('file:%s?mode=ro' % args.path, uri=True)
    try:
        if not 1 <= src.execute('PRAGMA user_version').fetchone()[0] <= SCHEMA_VERSION:
            raise UsageError('not a kb backup of schema version 1 to %d: %s'
                             % (SCHEMA_VERSION, args.path))
        # Prepare the restored image in memory, then copy it in with one backup step,
        # so no claim can land between the copy and the recovery flag.
        mem = sqlite3.connect(':memory:', isolation_level=None)
        src.backup(mem)
    except sqlite3.DatabaseError as e:
        raise UsageError('cannot read backup %s: %s' % (args.path, e))
    finally:
        src.close()
    with transaction(mem):
        migrate(mem)  # a backup taken before a schema upgrade
    # Sessions are identity, not ticket state: live tokens stay valid after a restore.
    mem.executemany('INSERT OR IGNORE INTO session (%s) VALUES (?, ?, ?, ?, ?, ?, ?, ?)'
                    % SESSION_COLUMNS,
                    conn.execute('SELECT %s FROM session' % SESSION_COLUMNS).fetchall())
    # The session log is a measurement, not ticket state: keep live events the backup lacks.
    mem.executemany('INSERT INTO session_event (%s) SELECT ?, ?, ?, ?, ?, ? WHERE NOT EXISTS'
                    ' (SELECT 1 FROM session_event WHERE harness=? AND harness_session=?'
                    ' AND event=? AND source=? AND cwd=? AND time=?)' % EVENT_COLUMNS,
                    [r + r for r in conn.execute('SELECT %s FROM session_event ORDER BY id'
                                                 % EVENT_COLUMNS)])
    mem.execute("INSERT OR REPLACE INTO meta VALUES ('recovery', ?)", (now(),))
    mem.backup(conn)
    mem.close()
    print('restored %s; claims and adds are blocked until kb recover --done' % args.path)
    for r in conn.execute("SELECT c.id, c.status, c.title, slabel(s.name, s.harness, s.token)"
                          " FROM ticket c"
                          " LEFT JOIN session s ON s.token=c.assignee"
                          " WHERE c.status IN ('doing', 'blocked') ORDER BY c.id"):
        print('reconcile #%d %s %s @%s' % r)


def cmd_recover(args):
    if not args.done:
        raise UsageError('run kb recover --done after reconciling every doing ticket')
    conn = connect()
    _, name = session(conn, args)
    if not is_curator(name):
        raise Rejected('recover rejected: curator only')
    with transaction(conn):
        cur = conn.execute("DELETE FROM meta WHERE key='recovery'")
        if cur.rowcount != 1:
            raise Rejected('board is not in recovery')
    print('recovery cleared')


