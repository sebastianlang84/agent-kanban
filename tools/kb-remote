#!/usr/bin/env python3
"""Forced SSH command that lets the Paperclip Orchestrator use the kb board and nothing else.

authorized_keys: restrict,from="172.22.0.0/16",command="/home/wasti/.local/bin/kb-remote <name>" <key>
One key per Paperclip agent; <name> is its kb session name (default: orchestrator).

The client sends kb arguments, for example `ssh kb board --repo market-digest`.
To send arguments with spaces without quoting problems, pass a JSON array on stdin:
`echo '["note","62","text with spaces"]' | ssh kb json`.

Each agent keeps one persistent kb session; its token stays on this host.
"""
import json, os, shlex, subprocess, sys
from pathlib import Path

KB = "/home/wasti/dev/agent-kanban/kb"
NAME = sys.argv[1] if len(sys.argv) > 1 else "orchestrator"
if not NAME.replace("-", "").isalnum():
    sys.exit("kb-remote: bad session name")
TOKEN_FILE = Path.home() / f".agents/state/kb/{NAME}.token"
ALLOWED = {"board", "show", "add", "claim", "release", "block", "resume", "abandon", "reopen", "note", "close", "whoami", "sessions", "touch", "label", "--help", "-h"}

args = shlex.split(os.environ.get("SSH_ORIGINAL_COMMAND", ""))
if args[:1] == ["kb"]:
    args = args[1:]
if args in (["json"], ["--json"]):
    args = json.load(sys.stdin)
    if not (isinstance(args, list) and all(isinstance(a, str) for a in args)):
        sys.exit("kb-remote: json expects a JSON array of strings on stdin")
if not args or args[0] == "help":
    args = ["--help"]
if args[0] not in ALLOWED:
    sys.exit(f"kb-remote: command not allowed: {args[0]} (allowed: {', '.join(sorted(ALLOWED))})")
if "--session" in args or "--take" in args:
    sys.exit("kb-remote: --session and --take are not allowed through the gateway")


def kb(*a, **kw):
    return subprocess.run(["python3", KB, *a], **kw)


token = TOKEN_FILE.read_text().strip() if TOKEN_FILE.exists() else ""
if not token or kb("--session", token, "whoami", capture_output=True).returncode != 0:
    out = kb("start", "--as", NAME, capture_output=True, text=True, check=True)
    token = out.stdout.strip().splitlines()[-1]
    TOKEN_FILE.write_text(token + "\n")
    TOKEN_FILE.chmod(0o600)

os.chdir(Path.home())
sys.exit(kb("--session", token, *args).returncode)
